---
/**
 * TestimonialCard — Single testimonial in glass-card style.
 *
 * @prop name       - Full name of the person
 * @prop role       - Job title
 * @prop company    - Company/organization name
 * @prop quote      - Full testimonial text
 * @prop highlight  - Key punchy phrase, visually prominent
 * @prop image      - Optional avatar path; omitting shows initials fallback
 * @prop index      - Stagger delay index (0, 1, 2…) for entrance animation
 */
import Icon from "./Icon.astro";

export interface Props {
  name: string;
  role: string;
  company: string;
  quote: string;
  highlight: string;
  image?: string;
  index?: number;
}

const {
  name,
  role,
  company,
  quote,
  highlight,
  image,
  index = 0,
} = Astro.props;

const initials = name
  .split(" ")
  .filter((_, i, arr) => i === 0 || i === arr.length - 1)
  .map((w) => w.charAt(0).toUpperCase())
  .join("");

const staggerMs = index * 100;
const staggerStyle = `--stagger-delay: ${staggerMs}ms`;
---

<style>
  .testimonial-card {
    animation: testimonial-in 400ms ease-out both;
    animation-delay: var(--stagger-delay, 0ms);
  }

  @keyframes testimonial-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonial-card {
      animation: none !important;
    }
  }
</style>

<article
  class="testimonial-card glass-card rounded-xl p-6 md:p-8 h-full flex flex-col hover:scale-[1.02] hover:shadow-md transition-[transform,box-shadow] duration-300"
  style={staggerStyle}
>
  <!-- Decorative quote icon -->
  <div class="mb-5" aria-hidden="true">
    <Icon name="material-symbols:format-quote" class="size-12 text-primary/20" />
  </div>

  <!-- Highlight phrase — visual anchor -->
  <blockquote class="flex-1">
    <p class="font-headline font-bold text-lg md:text-xl text-on-surface mb-4 leading-snug">
      {highlight}
    </p>

    <!-- Full quote -->
    <p class="text-on-surface-variant italic leading-relaxed mb-6 text-sm md:text-base">
      {quote}
    </p>
  </blockquote>

  <!-- Attribution row -->
  <div class="flex items-center gap-4 mt-auto pt-4 border-t border-outline-variant/30">
    {image ? (
      <img
        src={image}
        alt={name}
        class="size-11 rounded-full object-cover shrink-0"
        loading="lazy"
        width="44"
        height="44"
      />
    ) : (
      <div
        class="size-11 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center shrink-0 select-none"
        aria-hidden="true"
        role="img"
        aria-label={name}
      >
        <span class="text-sm font-bold">{initials}</span>
      </div>
    )}
    <div class="min-w-0">
      <p class="font-bold text-on-surface text-sm leading-tight">{name}</p>
      <p class="text-on-surface-variant text-xs leading-tight truncate">
        {role} &mdash; {company}
      </p>
    </div>
  </div>
</article>
