---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SectionHeading from "./SectionHeading.astro";

export interface Props {
  intro: string[];
  capitulos: Array<{
    id: string;
    rangoAnios: string;
    secciones: Array<{
      id: string;
      titulo: string;
      parrafos: Array<string | { lista: string[] }>;
      foto?: { src: ImageMetadata; alt: string };
    }>;
  }>;
}

const { intro, capitulos } = Astro.props;

const proseClasses = `prose prose-lg
  prose-p:text-on-surface-variant prose-p:leading-relaxed prose-p:mb-5
  prose-strong:text-on-surface prose-strong:font-semibold
  prose-ul:text-on-surface-variant prose-li:marker:text-primary prose-li:my-1
  prose-a:text-primary prose-a:underline hover:prose-a:text-primary/80`;

const [standfirst, ...restoIntro] = intro;

const fotos: Array<{ src: ImageMetadata; alt: string }> = [];
for (const cap of capitulos) for (const s of cap.secciones) if (s.foto) fotos.push(s.foto);

const railDe: Record<string, number> = {};
let railActual = 0;
for (const cap of capitulos) {
  for (const s of cap.secciones) {
    if (s.foto) railActual = fotos.indexOf(s.foto);
    railDe[s.id] = railActual;
  }
}
---

<section id="historia" class="relative overflow-x-clip scroll-mt-24 bg-surface py-14 sm:py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 md:px-8">
    <SectionHeading title="Nuestra historia" />

    <div class="lg:grid lg:grid-cols-[16rem_1fr] lg:gap-12 xl:grid-cols-[14rem_minmax(0,38rem)_minmax(0,1fr)] xl:gap-12">
      <nav
        aria-label="Índice de la historia"
        class="relative z-20 hidden lg:block lg:sticky lg:top-24 lg:self-start"
      >
        <ul class="border-l border-outline-variant/40">
          {capitulos.map((cap) => (
            <li>
              <a
                href={`#${cap.id}`}
                class="indice-cap flex items-center min-h-[44px] pl-4 -ml-px border-l border-transparent font-headline font-semibold text-sm text-on-surface hover:text-primary"
              >
                {cap.rangoAnios}
              </a>
              <ul>
                {cap.secciones.map((seccion) => (
                  <li>
                    <a
                      href={`#${seccion.id}`}
                      data-historia-link
                      class="indice-link flex items-center min-h-[44px] pl-4 -ml-px border-l border-transparent text-sm leading-snug text-on-surface-variant hover:text-primary"
                    >
                      {seccion.titulo}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </nav>

      <article class="min-w-0">
        <div class:list={["historia-intro max-w-[41rem] xl:max-w-[38rem]", proseClasses]}>
          <p class="historia-standfirst">{standfirst}</p>
          {restoIntro.map((parrafo) => <p>{parrafo}</p>)}
        </div>

        {capitulos.map((cap, i) => (
          <section
            class="historia-capitulo"
            data-bg={i % 2 === 1 ? "alt" : "base"}
            aria-labelledby={cap.id}
          >
            <div class="historia-cap-inner">
              <h2
                id={cap.id}
                class="scroll-mt-24 font-headline font-bold text-primary text-2xl md:text-3xl mb-6 md:mb-8"
              >
                {cap.rangoAnios}
              </h2>

              {cap.secciones.map((seccion) => (
                <details open class="historia-seccion">
                  <summary>
                    <h3
                      id={seccion.id}
                      class="scroll-mt-24 font-headline font-bold text-on-surface text-xl sm:text-2xl"
                      data-historia-seccion
                      data-rail={railDe[seccion.id]}
                    >
                      {seccion.titulo}
                    </h3>
                  </summary>

                  {seccion.foto && (
                    <figure class="mb-6 xl:hidden">
                      <Image
                        src={seccion.foto.src}
                        alt={seccion.foto.alt}
                        format="webp"
                        layout="constrained"
                        sizes="(min-width: 768px) 656px, 100vw"
                        class="w-full h-auto rounded-lg"
                        loading="lazy"
                      />
                    </figure>
                  )}

                  <div class:list={["min-w-0 max-w-[41rem] xl:max-w-[38rem]", proseClasses]}>
                    {seccion.parrafos.map((bloque) =>
                      typeof bloque === "string"
                        ? <p>{bloque}</p>
                        : <ul>{bloque.lista.map((item) => <li>{item}</li>)}</ul>
                    )}
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))}
      </article>

      <aside
        class="hidden xl:block xl:sticky xl:top-24 xl:self-start"
        aria-label="Imágenes de la historia"
      >
        {fotos.map((foto, i) => (
          <Image
            src={foto.src}
            alt={foto.alt}
            format="webp"
            layout="constrained"
            sizes="288px"
            class={i === 0 ? "w-full h-auto rounded-lg" : "hidden w-full h-auto rounded-lg"}
            data-rail-img={i}
            loading={i === 0 ? "eager" : "lazy"}
          />
        ))}
      </aside>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var mq = window.matchMedia("(min-width: 64rem)");
    function aplicar() {
      var secs = document.querySelectorAll(".historia-seccion");
      for (var i = 0; i < secs.length; i++) {
        if (mq.matches) secs[i].setAttribute("open", "");
        else secs[i].removeAttribute("open");
      }
    }
    aplicar();
    if (mq.addEventListener) mq.addEventListener("change", aplicar);
    else if (mq.addListener) mq.addListener(aplicar);
  })();
</script>

<style>
  .historia-standfirst {
    font-size: 1.3125rem;
    line-height: 1.5;
    color: var(--color-on-surface);
  }

  .historia-capitulo {
    position: relative;
    padding-block: 2.5rem;
  }

  /* Banda de capítulo a sangre: se centra en el viewport y cubre los 100vw.
     El offset negativo compensa que la columna de contenido no está centrada. */
  .historia-capitulo::before {
    content: "";
    position: absolute;
    inset-block: 0;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    z-index: 0;
  }

  .historia-capitulo[data-bg="alt"]::before {
    background-color: var(--color-surface-container-low);
  }

  .historia-cap-inner {
    position: relative;
    z-index: 1;
  }

  .historia-seccion {
    margin-top: 2rem;
  }

  .historia-seccion > summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    list-style: none;
  }

  details.historia-seccion > summary > h3 {
    margin: 0;
  }

  .historia-seccion > summary::-webkit-details-marker {
    display: none;
  }

  .historia-seccion > summary::marker {
    content: "";
  }

  .historia-seccion > summary::after {
    content: "\25BE";
    flex: none;
    font-size: 1rem;
    line-height: 1;
    color: var(--color-on-surface-variant);
    transition: transform 0.2s ease;
  }

  .historia-seccion[open] > summary::after {
    transform: rotate(180deg);
  }

  .indice-link[aria-current="true"] {
    color: var(--color-primary);
    border-color: var(--color-primary);
    font-weight: 600;
  }

  @media (min-width: 64rem) {
    .historia-capitulo::before {
      margin-left: -9.5rem;
    }
    .historia-seccion > summary {
      pointer-events: none;
    }
    .historia-seccion > summary::after {
      display: none;
    }
  }

  @media (min-width: 80rem) {
    .historia-capitulo::before {
      margin-left: 2rem;
    }
  }
</style>

<script>
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-historia-link]"),
  );
  const secciones = Array.from(
    document.querySelectorAll<HTMLElement>("[data-historia-seccion]"),
  );
  const railImgs = Array.from(
    document.querySelectorAll<HTMLImageElement>("[data-rail-img]"),
  );

  function mostrarRail(n: number) {
    for (const img of railImgs) {
      if (Number(img.dataset.railImg) === n) img.classList.remove("hidden");
      else img.classList.add("hidden");
    }
  }

  if (secciones.length > 0) {
    const porId = new Map<string, HTMLAnchorElement>();
    for (const link of links) {
      const id = link.getAttribute("href")?.replace("#", "");
      if (id) porId.set(id, link);
    }

    let activo: HTMLAnchorElement | null = null;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const link = porId.get(entry.target.id);
          if (!link || link === activo) continue;
          activo?.removeAttribute("aria-current");
          link.setAttribute("aria-current", "true");
          activo = link;
        }
      },
      { rootMargin: "-20% 0px -75% 0px", threshold: 0 },
    );

    for (const seccion of secciones) observer.observe(seccion);

    // Foto activa del rail: determinista por posición de scroll (la última sección
    // cuyo título pasó la línea de referencia define la foto). En secciones sin
    // foto el índice se hereda, así la foto nunca desaparece.
    let pendiente = false;
    function actualizarRail() {
      pendiente = false;
      const linea = window.innerHeight * 0.35;
      let n = 0;
      for (const s of secciones) {
        if (s.getBoundingClientRect().top <= linea && s.dataset.rail !== undefined) {
          n = Number(s.dataset.rail);
        }
      }
      mostrarRail(n);
    }
    function alScroll() {
      if (!pendiente) {
        pendiente = true;
        requestAnimationFrame(actualizarRail);
      }
    }
    window.addEventListener("scroll", alScroll, { passive: true });
    window.addEventListener("resize", alScroll, { passive: true });
    window.addEventListener("load", actualizarRail);
    actualizarRail();
  }
</script>
