---
import Icon from "./Icon.astro";
import DarkModeToggle from "./DarkModeToggle.astro";

export interface Props {
  /** Which page is currently active — determines the highlighted nav link */
  active?: "inicio" | "quienes-somos" | "afiliadas" | "capacitacion" | "novedades" | "rse" | "contacto" | "afiliacion";
}

const { active } = Astro.props;

const links = [
  { href: "", label: "Inicio", key: "inicio" as const },
  { href: "quienes-somos", label: "Quiénes somos", key: "quienes-somos" as const },
  { href: "afiliadas", label: "Afiliadas", key: "afiliadas" as const },
  { href: "capacitacion", label: "Capacitación", key: "capacitacion" as const },
  { href: "novedades", label: "Novedades", key: "novedades" as const },
  { href: "rse", label: "RSE", key: "rse" as const },
  { href: "contacto", label: "Contacto", key: "contacto" as const },
];

const linkClass = (isActive: boolean) =>
  isActive
    ? "text-primary border-b-2 border-primary pb-1"
    : "text-on-surface-variant hover:text-primary hover:underline hover:underline-offset-4 transition-colors";
---

<nav id="main-nav" class="sticky top-0 z-50 bg-black/20 backdrop-blur-md transition-all duration-300">
  <!-- Skip to main content -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2 rounded-md z-[60] bg-surface-bright text-on-surface px-4 py-2">
    Saltar al contenido principal
  </a>

  <div class="flex justify-between items-center px-4 sm:px-6 md:px-8 py-4 max-w-7xl mx-auto">
    <!-- Logo -->
    <a href="" class="flex items-center shrink-0">
      <img
        src="logo-cbhe.webp"
        alt="CBHE — Cámara Boliviana de Hidrocarburos y Energía"
        width="401"
        height="166"
        class="h-[48px] sm:h-[56px] md:h-[64px] w-auto"
      />
    </a>

    <!-- Desktop links -->
    <div class="hidden lg:flex items-center space-x-8">
      {links.map((link) => (
        <a href={link.href} class={linkClass(active === link.key)}>
          {link.label}
        </a>
      ))}
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-4">
      <DarkModeToggle />
      <a
        href="afiliacion"
          class="border-2 border-primary text-primary rounded-md px-4 sm:px-6 py-2 sm:py-2.5 font-semibold hover:bg-primary/10 transition-all min-h-[44px] text-sm md:text-base spring-press"
      >
        Afiliarse
      </a>

      <!-- Mobile menu: native <details> — zero JS, keyboard + screen reader accessible -->
      <details class="group lg:hidden">
        <summary class="list-none cursor-pointer p-2 -mr-2 min-h-11 min-w-11 flex items-center justify-center">
          <span class="group-open:hidden" aria-label="Abrir menú de navegación">
            <Icon name="material-symbols:menu" class="size-6 text-on-surface-variant" />
          </span>
          <span class="hidden group-open:inline" aria-label="Cerrar menú de navegación">
            <Icon name="material-symbols:close" class="size-6 text-on-surface-variant" />
          </span>
        </summary>
        <div class="absolute left-0 right-0 top-full bg-surface-bright border-t border-outline-variant/30 shadow-lg rounded-lg">
          <div class="flex flex-col px-8 py-4 space-y-4">
            {links.map((link) => (
              <a href={link.href} class={linkClass(active === link.key) + " text-base py-1"}>
                {link.label}
              </a>
            ))}
          </div>
        </div>
      </details>
    </div>
  </div>
</nav>
<script>
  const nav = document.getElementById('main-nav');
  if (nav) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        nav.classList.add('bg-surface-bright/90', 'shadow-sm');
        nav.classList.remove('bg-black/20');
      } else {
        nav.classList.add('bg-black/20');
        nav.classList.remove('bg-surface-bright/90', 'shadow-sm');
      }
    }, { passive: true });
  }
</script>
