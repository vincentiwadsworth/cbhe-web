---
import Icon from "./Icon.astro";

/* ------------------------------------------------------------------ */
/*  Types                                                               */
/* ------------------------------------------------------------------ */

interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  /** FAQs to render — the component renders nothing if omitted or empty. */
  faqs?: FAQ[];
  /** Optional wrapper class applied to the outer section. */
  className?: string;
}

const { faqs, className = "" } = Astro.props;
---

{/* ================================================================== */}
{/*  Template                                                            */}
{/* ================================================================== */}

{
  faqs && faqs.length > 0 && (
    <section class={className} aria-labelledby="faq-heading">
      <h2
        id="faq-heading"
        class="text-2xl font-headline font-bold text-on-surface mb-6"
      >
        Preguntas frecuentes
      </h2>

      <div class="space-y-3 max-w-3xl">
        {faqs.map((faq, index) => (
          <details
            id={`faq-${index}`}
            class="faq-item bg-surface-container-low rounded-lg border-l-4 border-transparent transition-[border-color] duration-200 open:border-primary"
          >
            <summary class="flex items-center justify-between gap-3 p-4 cursor-pointer font-semibold text-on-surface text-sm sm:text-base select-none min-h-[44px] list-none">
              <span>{faq.question}</span>

              {/* Custom caret — rotates 180° when open, replaces browser ::marker */}
              <Icon
                name="material-symbols:expand-more"
                class="size-5 text-on-surface-variant shrink-0 transition-transform duration-200 faq-caret"
                decorative
              />
            </summary>

            <div class="faq-answer">
              <p class="px-4 pb-4 text-sm text-on-surface-variant leading-relaxed">
                {faq.answer}
              </p>
            </div>
          </details>
        ))}
      </div>
    </section>
  )
}

{/* ================================================================== */}
{/*  Component-scoped styles                                             */}
{/* ================================================================== */}

<style>
  /* Collapsed state: content hidden, zero height */
  .faq-answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 300ms ease;
  }

  .faq-answer > p {
    overflow: hidden;
  }

  /* Open state: content revealed with smooth animation */
  .faq-item[open] .faq-answer {
    grid-template-rows: 1fr;
  }

  /* Rotate caret on open */
  .faq-item[open] .faq-caret {
    transform: rotate(180deg);
  }
</style>
