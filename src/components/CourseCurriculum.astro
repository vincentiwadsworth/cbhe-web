---
import Icon from "./Icon.astro";

/* ------------------------------------------------------------------ */
/*  mdToHtml — lightweight markdown-to-HTML converter (~40 lines)      */
/*  Handles: paragraphs, **bold**, - list items, ### headings, links   */
/*  Pure function — zero side effects, no external dependency.         */
/* ------------------------------------------------------------------ */

export function mdToHtml(markdown: string): string {
  if (!markdown) return "";

  const lines = markdown.split("\n");
  const output: string[] = [];
  const pendingList: string[] = [];

  function flushList() {
    if (pendingList.length > 0) {
      output.push("<ul>" + pendingList.join("") + "</ul>");
      pendingList.length = 0;
    }
  }

  for (const line of lines) {
    /* Inline formatting — apply before block-level detection */
    let processed = line.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
    processed = processed.replace(
      /\[([^\]]+)\]\(([^)]+)\)/g,
      '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>',
    );

    /* ### Heading → <h4> (h2=section, h3=module title, h4=sub-heading) */
    if (/^### (.+)/.test(processed)) {
      flushList();
      processed = processed.replace(/^### (.+)/, "<h4>$1</h4>");
      output.push(processed);
      continue;
    }

    /* Unordered list items */
    if (/^[-*] (.+)/.test(processed)) {
      processed = processed.replace(/^[-*] (.+)/, "<li>$1</li>");
      pendingList.push(processed);
      continue;
    }

    /* Blank lines flush any pending list and separate paragraphs */
    if (processed.trim() === "") {
      flushList();
      continue;
    }

    /* Everything else is a paragraph */
    flushList();
    output.push(`<p>${processed}</p>`);
  }

  flushList();
  return output.join("\n");
}

/* ------------------------------------------------------------------ */
/*  Props                                                               */
/* ------------------------------------------------------------------ */

interface Props {
  /** Raw markdown body from the collection entry. */
  body: string;
  /** Optional wrapper class applied to the outer container. */
  className?: string;
}

const { body, className = "" } = Astro.props;

/* ------------------------------------------------------------------ */
/*  Section parsing                                                     */
/* ------------------------------------------------------------------ */

interface Section {
  heading: string;
  headingId: string;
  content: string;
  icon: "groups" | "check-circle" | "school" | "description";
  moduleLabel: string;
}

/** Generate a safe HTML id from heading text. */
function slugify(text: string): string {
  return text
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
}

/** Detect section type from heading text for icon assignment. */
function sectionIcon(heading: string): Section["icon"] {
  const h = heading.toLowerCase().trim();
  if (/^(dirigido\s+a|qui[ée]nes\s+pueden\s+participar)/i.test(h))
    return "groups";
  if (/^objetivos?\b/i.test(h)) return "check-circle";
  if (/^temario\b/i.test(h)) return "school";
  return "description";
}

/** Split raw markdown body into H2-delimited sections. */
function parseSections(rawBody: string): Section[] {
  if (!rawBody) return [];

  /* Split on lines that start with "## " */
  const parts = rawBody.split(/^## /m);

  const sections: Section[] = [];
  let moduleIndex = 0;

  for (const part of parts) {
    const trimmed = part.trim();
    if (!trimmed) continue;

    const firstNewline = trimmed.indexOf("\n");
    let heading: string;
    let content: string;

    if (firstNewline === -1) {
      heading = trimmed;
      content = "";
    } else {
      heading = trimmed.substring(0, firstNewline).trim();
      content = trimmed.substring(firstNewline + 1).trim();
    }

    if (!heading) continue;
    /* Skip sections with no content (heading-only, whitespace-only) */
    if (!content.trim()) continue;

    moduleIndex++;
    sections.push({
      heading,
      headingId: slugify(heading),
      content,
      icon: sectionIcon(heading),
      moduleLabel: `Módulo ${moduleIndex}`,
    });
  }

  return sections;
}

const sections = parseSections(body);

/* Alternating left border colors for visual rhythm */
const borderColors = [
  "border-l-primary",
  "border-l-secondary",
  "border-l-tertiary",
] as const;
---

{/* ================================================================== */}
{/*  Template: NO H2 sections → render entire body as prose fallback    */}
{/* ================================================================== */}

{
  sections.length === 0 && body.trim() && (
    <div class={`curriculum-prose ${className}`}>
      <Fragment set:html={mdToHtml(body)} />
    </div>
  )
}

{/* ================================================================== */}
{/*  Template: H2 sections → module cards                                */}
{/* ================================================================== */}

{
  sections.length > 0 && (
    <div class={`space-y-8 ${className}`}>
      {sections.map((section, index) => {
        const borderColor = borderColors[index % 3];
        const sectionHtml = mdToHtml(section.content);

        return (
          <section
            id={section.headingId}
            aria-labelledby={`curriculum-${section.headingId}`}
            class={[
              "reveal",
              "bg-surface-container-low rounded-lg p-6 border-l-4",
              borderColor,
            ].join(" ")}
          >
            {/* Module number badge */}
            <span class="inline-block bg-primary-container/30 text-primary text-xs font-bold px-2.5 py-1 rounded-full uppercase tracking-wider mb-3">
              {section.moduleLabel}
            </span>

            {/* Module title */}
            <h3
              id={`curriculum-${section.headingId}`}
              class="text-xl font-headline font-bold text-on-surface mb-4 flex items-center gap-2.5"
            >
              <Icon
                name={`material-symbols:${section.icon}`}
                class="size-6 text-primary shrink-0"
              />
              {section.heading}
            </h3>

            {/* Module body */}
            <div
              class="curriculum-prose"
              set:html={sectionHtml}
            />
          </section>
        );
      })}
    </div>
  )
}

{/* ================================================================== */}
{/*  Component-scoped styles for rendered HTML                           */}
{/* ================================================================== */}

<style>
  .curriculum-prose {
    color: var(--color-on-surface-variant);
    font-size: 0.875rem;
    line-height: 1.625;
  }

  /* Paragraphs */
  .curriculum-prose :global(p) {
    margin-bottom: 0.75rem;
  }

  .curriculum-prose :global(p:last-child) {
    margin-bottom: 0;
  }

  /* Bold text */
  .curriculum-prose :global(strong) {
    font-weight: 600;
    color: var(--color-on-surface);
  }

  /* H4 sub-headings — used for ### in markdown (h3 is reserved for module titles) */
  .curriculum-prose :global(h4) {
    font-size: 1rem;
    font-weight: 700;
    font-family: "Inter", sans-serif;
    color: var(--color-on-surface);
    background-color: color-mix(
      in srgb,
      var(--color-primary-container) 20%,
      transparent
    );
    padding: 0.625rem 0.875rem;
    border-radius: 0.375rem;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  /* Lists */
  .curriculum-prose :global(ul) {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-top: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .curriculum-prose :global(li) {
    margin-bottom: 0.25rem;
  }

  .curriculum-prose :global(li:last-child) {
    margin-bottom: 0;
  }

  /* Links */
  .curriculum-prose :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 500;
  }

  .curriculum-prose :global(a:hover) {
    color: var(--color-on-primary-container);
  }

  /* Ensure links meet 44×44 touch target — only standalone links (not inline text) */
  .curriculum-prose :global(a[target="_blank"]) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
</style>
