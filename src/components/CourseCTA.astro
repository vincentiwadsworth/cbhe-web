---
/* ------------------------------------------------------------------ */
/*  Props                                                               */
/* ------------------------------------------------------------------ */

interface Props {
  /** Optional Canva link — renders secondary "Ver en Canva" button. */
  canvaLink?: string;
  /** WhatsApp number for the primary CTA (default: CBHE capacitación). */
  whatsappNumber?: string;
  /** Optional wrapper class. */
  className?: string;
}

const {
  canvaLink,
  whatsappNumber = "59179891193",
  className = "",
} = Astro.props;

/* Encode WhatsApp message — default inquiry text for courses */
const waMessage = encodeURIComponent(
  "Hola, quiero información sobre el curso.",
);
const waHref = `https://wa.me/${whatsappNumber}?text=${waMessage}`;
---

{/* ================================================================== */}
{/*  Sticky mobile CTA bar                                               */}
{/*                                                                      */}
{/*  Hidden by default (translate-y-full). When the user scrolls past    */}
{/*  the #cta-sentinel element (placed in the parent page's hero),       */}
{/*  IntersectionObserver slides it into view. JS disabled → stays        */}
{/*  hidden, no broken experience.                                        */}
{/*                                                                      */}
{/*  Hidden on md+ screens — replaced by in-page CTAs in [slug].astro.   */}
{/* ================================================================== */}

<div
  id="sticky-cta"
  aria-label="Acciones del curso"
  class={`${className} fixed bottom-0 left-0 right-0 z-50 translate-y-full will-change-transform bg-surface/95 backdrop-blur-md border-t border-outline-variant/30 p-3 sm:p-4 md:hidden`}
  style="transition: transform 300ms ease; padding-bottom: max(0.75rem, env(safe-area-inset-bottom, 0px));"
>
  <div class="flex items-center gap-3 max-w-5xl mx-auto">
    {/* Primary CTA — WhatsApp */}
    <a
      href={waHref}
      target="_blank"
      rel="noopener noreferrer"
      class="flex-1 text-center bg-primary text-on-primary py-3 rounded-md font-semibold hover:bg-primary/90 hover:shadow-md transition-all min-h-[44px] text-sm inline-flex items-center justify-center gap-2 spring-press"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="size-4 shrink-0"
        aria-hidden="true"
      >
        <path
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"
        /></svg
      >Inscribirme ahora
    </a>

    {/* Secondary CTA — Canva link (optional) */}
    {canvaLink && (
      <a
        href={canvaLink}
        target="_blank"
        rel="noopener noreferrer"
        class="text-center bg-surface-container-high text-primary py-3 px-4 rounded-md font-semibold hover:bg-surface-container hover:border-primary/30 border border-outline-variant/20 transition-all min-h-[44px] text-sm inline-flex items-center justify-center gap-2 spring-press shrink-0"
      >
        Ver en Canva
      </a>
    )}
  </div>
</div>

{/* ================================================================== */}
{/*  IntersectionObserver — slide bar in when user scrolls past hero     */}
{/*  Degrades gracefully: JS disabled → bar stays hidden (translate-y-full) */}
{/* ================================================================== */}

<script>
  /* Sentinels and classes set as constants so Tailwind JIT picks them up */
  const SENTINEL_ID = "cta-sentinel";
  const BAR_ID = "sticky-cta";
  const HIDDEN_CLASS = "translate-y-full";
  const VISIBLE_CLASS = "translate-y-0";

  const sentinel = document.getElementById(SENTINEL_ID);
  const stickyCta = document.getElementById(BAR_ID);

  if (sentinel && stickyCta) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        stickyCta.classList.toggle(HIDDEN_CLASS, entry.isIntersecting);
        stickyCta.classList.toggle(VISIBLE_CLASS, !entry.isIntersecting);
      },
      { threshold: 0 },
    );
    observer.observe(sentinel);
  }
</script>
