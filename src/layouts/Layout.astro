---
import "../styles/global.css";
import CursorGlow from "../components/CursorGlow.astro";
import { getCollection } from "astro:content";
import { isPastDate } from "../utils/date";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Path relativo SIN base — ej: "quienes-somos" o "novedades/proyecto-x1" */
  currentPath?: string;
  noindex?: boolean;
  ogType?: string;
  /** Article JSON-LD: fecha de publicación */
  datePublished?: string;
  /** Article JSON-LD: fecha de modificación */
  dateModified?: string;
  /** Article JSON-LD: autor */
  author?: string;
}

const {
  title,
  description,
  image,
  currentPath,
  noindex,
  ogType = "website",
  datePublished,
  dateModified,
  author = "CBHE",
} = Astro.props;

const baseHref = import.meta.env.BASE_URL === '/'
  ? import.meta.env.SITE
  : `${import.meta.env.SITE}${import.meta.env.BASE_URL}/`;

// El asistente llama a una Edge Function de Supabase que guarda la clave de
// DeepSeek server-side. Ninguna clave de IA se expone al navegador.
const chatEndpoint = import.meta.env.VITE_SUPABASE_URL
  ? `${import.meta.env.VITE_SUPABASE_URL}/functions/v1/asistente`
  : "";

// Build company knowledge base for the chatbot
const grupoLabels: Record<string, string> = {
  upstream: "Exploración y Producción",
  pozo: "Servicios en Pozo",
  superficie: "Servicios en Superficie",
  downstream: "Industria y Transporte",
  auxiliares: "Servicios Auxiliares",
  adherentes: "Adherentes",
};
const todasEmpresas = await getCollection("empresas", ({ data }) => !data.draft);
const empresasByGrupo = Object.entries(grupoLabels)
  .map(([key, label]) => {
    const items = todasEmpresas
      .filter((e) => e.data.grupo === key)
      .map((e) => {
        let line = `- ${e.data.nombre}${e.data.website ? ` (${e.data.website})` : ""}`;
        if (e.data.description) line += `: ${e.data.description}`;
        return line;
      });
    return items.length > 0 ? `${label} (${items.length}):\n${items.join("\n")}` : "";
  })
  .filter(Boolean)
  .join("\n\n");
const empresasContext = `Empresas afiliadas a la CBHE:\n\n${empresasByGrupo}`;

// Build courses knowledge base for the chatbot
const todosCursos = (await getCollection("cursos", ({ data }) => !data.draft))
  .filter((c) => !isPastDate(c.data.startDate));
const cursosContext = todosCursos.length > 0
  ? "Capacitaciones de la CBHE:\n\n" + todosCursos.map((c) => {
      const parts = [`- ${c.data.title} (${c.data.category}, ${c.data.modality})`];
      parts.push(`  Inicio: ${c.data.startDate}`);
      parts.push(`  Precio: ${c.data.price}`);
      if (c.data.description) parts.push(`  ${c.data.description.slice(0, 150)}`);
      return parts.join("\n");
    }).join("\n\n")
  : "";

// Build afiliación knowledge base for the chatbot
const afiliacionContext = `Cómo afiliarse a la CBHE: documentación necesaria, proceso de aprobación y beneficios.

Documentación necesaria (se entrega en fotocopia simple o de manera digital para su revisión y aprobación):

Empresas nacionales (8 documentos):
1. Carta de solicitud de afiliación dirigida al Sr. Enzo Michel, Director Ejecutivo de la CBHE.
2. Testimonio de Minuta de Constitución de la Sociedad, con modificaciones y/o enmiendas si las hubiera.
3. Testimonio de poder del representante legal, con modificaciones y/o enmiendas si las hubiera.
4. Matrícula de SEPREC actualizada a la fecha.
5. NIT (Número de Identificación Tributaria).
6. Estados Financieros auditados, con sello de contador y registrados en la SNII.
7. Padrón Municipal.
8. Formulario original de la solicitud de ingreso a la CBHE.

Empresas extranjeras (7 documentos):
1. Certificado o Escritura de Constitución: copia legalizada o certificada, apostillada o legalizada, con traducción oficial al español.
2. Estatutos Sociales vigentes o documento equivalente: apostillados o legalizados, con traducción oficial al español.
3. Certificado de Vigencia o Existencia Legal: emitido por la autoridad competente, apostillado o legalizado, traducido oficialmente, con antigüedad no mayor a 90 días.
4. Poder o nombramiento del representante legal en Bolivia: con facultades expresas para actuar en territorio boliviano, apostillado o legalizado, traducido oficialmente.
5. Documento de identidad o pasaporte del representante legal: copia vigente, con traducción oficial si está en otro idioma.
6. Carta de intención: nota formal en papel membretado, dirigida al Sr. Enzo Michel, Director Ejecutivo de la CBHE.
7. Certificado de domicilio o registro tributario en el país de origen: apostillado o legalizado, con traducción oficial.

Consideraciones para empresas extranjeras: toda documentación extranjera debe apostillarse o legalizarse y acompañarse de traducción oficial al español. Una vez en Bolivia, los documentos deben protocolizarse ante Notaría de Fe Pública. La documentación puede presentarse en formato físico. La CBHE puede requerir documentación complementaria para verificar autenticidad o vigencia.

Proceso de aprobación (3 etapas):
1. Revisión del área legal: el área legal revisa la solicitud y verifica que la documentación esté completa y vigente.
2. Aprobación por el Directorio: el Directorio decide la incorporación con el voto favorable de al menos dos tercios (2/3) de sus miembros.
3. Notificación del grupo asignado: la CBHE notifica a la empresa el grupo asignado y los pasos para completar la afiliación.

Grupos de afiliación (5): Exploración y Explotación de Hidrocarburos; Industria, Transporte y Distribución de hidrocarburos y energía; Servicios y Suministros Especializados en Pozo; Servicios y Suministros Especializados en Superficie; Servicios Auxiliares. La categoría depende de la información presentada, la especialidad y el patrimonio de la empresa.

Aportes de inscripción y mensuales: varían según el grupo asignado y se informan directamente a cada empresa durante el proceso. No se publican montos.

Beneficios de la afiliación (10):
- Representación sectorial: gestiones ante entidades públicas y privadas, participación en comisiones sectoriales, reuniones de Grupo, charlas y reuniones interinstitucionales.
- Apoyo legal: asesoramiento en trámites con instituciones públicas, seguimiento de temas normativos, participación en la elaboración de normas y estándares.
- Información exclusiva: información y recursos exclusivos para asociados, certificado de afiliación para licitaciones, encuestas y estudios sectoriales.
- Networking: red especializada de contactos del sector, actividades de confraternización, reconocimientos y premiaciones, actividades deportivas.
- Capacitación y eventos: descuentos en cursos y eventos (+100 cursos), cursos in-company, apoyo en la organización del Congreso Bolivia Gas & Energía.
- Publicaciones: cobertura de prensa, artículos en publicaciones institucionales, cifras y estadísticas del sector.
- Virtual y mailings: boletines informativos por correo, servicio de correo masivo para comunicados al sector.
- Alianzas y membresías: novedades de entidades aliadas, eventos internacionales representando a Bolivia, descuentos en eventos internacionales.
- Infraestructura: descuentos en alquiler de equipos y salones, servicios de tele y videoconferencia, área social para actividades.
- Fundación social y Centro de Arbitraje: iniciativas gremiales de beneficio social, resolución especializada de conflictos, soporte para gestiones sociales.

Para iniciar el proceso, la empresa debe completar el formulario de afiliación disponible en la sección "Afiliación" del sitio web cbhe.org.bo o contactar directamente al equipo de la CBHE.`;

const chatbotContext = [empresasContext, cursosContext, afiliacionContext].filter(Boolean).join("\n\n");

// Canonical URL: Astro.url ya incluye site + base + path
const canonicalUrl = Astro.url.href;

// Open Graph: absolute URLs for images (required by social platforms)
const ogImageUrl = new URL(image || 'og-default.png', baseHref).href;
// Square fallback for WhatsApp — WhatsApp usa el último og:image tag y prefiere 1:1
const ogImageSquareUrl = new URL('og-default-square.png', baseHref).href;

// Breadcrumb: infer from currentPath segments
const breadcrumbSegments: { name: string; href: string }[] = [];
if (currentPath) {
  const segments = currentPath.split("/").filter(Boolean);
  let acc = "";
  for (const seg of segments) {
    acc += `/${seg}`;
    // prettier names
    const nameMap: Record<string, string> = {
      "novedades": "Novedades",
      "capacitacion": "Capacitación",
    };
    const name = nameMap[seg] ?? seg.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
    breadcrumbSegments.push({ name, href: acc });
  }
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#00507e" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1012" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <!-- Prevent flash of wrong theme: apply dark class BEFORE first paint -->
    <script is:inline>
      (function(){var e=localStorage.getItem('theme');if(e==='dark'||(!e&&window.matchMedia('(prefers-color-scheme:dark)').matches))document.documentElement.classList.add('dark');setTimeout(function(){document.documentElement.classList.add('theme-transition-ready')},100)})();
    </script>
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <base href={baseHref} />
    <!-- Favicon stack -->
    <link rel="icon" href="favicon-cbhe.svg" type="image/svg+xml" />
    <link rel="icon" href="favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="site.webmanifest" />
    <link rel="preconnect" href="https://lh3.googleusercontent.com" />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://api.web3forms.com" />
    {description && <meta name="description" content={description} />}
    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | CBHE`} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Square fallback: WhatsApp usa el último og:image y prefiere 1:1 -->
    <meta property="og:image" content={ogImageSquareUrl} />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="800" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="CBHE" />
    <meta property="og:locale" content="es_BO" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@CBHEnergia" />
    <meta name="twitter:title" content={`${title} | CBHE`} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />
    <title>{title} | CBHE</title>
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "name": "CBHE — Cámara Boliviana de Hidrocarburos y Energía",
          "url": baseHref,
          "logo": new URL("logo-cbhe.webp", baseHref).href,
          "sameAs": [
            "https://www.facebook.com/CBHEnergia",
            "https://www.linkedin.com/company/c%C3%A1mara-boliviana-de-hidrocarburos-y-energ%C3%ADa",
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "email": "cbhe@cbhe.org.bo",
            "contactType": "customer service",
          },
        },
        {
          "@type": "WebSite",
          "name": "CBHE",
          "url": baseHref,
          "description": description || "Cámara Boliviana de Hidrocarburos y Energía — Integramos energías con liderazgo e innovación.",
          "inLanguage": "es-BO",
        },
        ...(breadcrumbSegments.length > 0 ? [{
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Inicio", "item": baseHref },
            ...breadcrumbSegments.map((seg, i) => ({
              "@type": "ListItem",
              "position": i + 2,
              "name": seg.name,
              "item": new URL(seg.href.replace(/^\//, ""), baseHref).href,
            })),
          ],
        }] : []),
        ...(image ? [{
          "@type": "ImageObject",
          "url": ogImageUrl,
          "caption": title,
        }] : []),
        ...(datePublished ? [{
          "@type": "Article",
          "headline": title,
          "description": description,
          "image": ogImageUrl,
          "author": { "@type": "Organization", "name": author },
          "datePublished": datePublished,
          ...(dateModified ? { "dateModified": dateModified } : {}),
          "publisher": {
            "@type": "Organization",
            "name": "CBHE — Cámara Boliviana de Hidrocarburos y Energía",
            "logo": { "@type": "ImageObject", "url": new URL("logo-cbhe.webp", baseHref).href },
          },
        }] : []),
      ],
    })} />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-primary focus:text-on-primary focus:px-4 focus:py-2 focus:rounded-sm"
    >
      Saltar al contenido principal
    </a>
    <CursorGlow />
    <slot />

    <!-- Asistente virtual CBHE — proxy server-side: la clave de DeepSeek vive en
         la Edge Function de Supabase (secret) y nunca llega al navegador. -->
    <script is:inline define:vars={{ chatbotContext, chatEndpoint }}>
      (function () {
        if (!chatEndpoint || !chatbotContext) return;

        const systemPrompt = [
              "Es el asistente virtual de la CBHE (Cámara Boliviana de Hidrocarburos y Energía). Responda en español, de forma profesional pero cercana.",
              "",
              "REGLAS:",
              "Si no sabe algo, sugiera contactar a cbhe@cbhe.org.bo.",
              "NUNCA invente información. Si no tiene datos sobre un tema específico en la 'Fuente de verdad', no invente listas, beneficios, procesos ni ningún hecho. Informe que no tiene esa información y sugiera contactar a cbhe@cbhe.org.bo.",
              "FORMATO: use texto plano con saltos de línea. NO use Markdown excepto **palabra** para enfatizar 1-3 palabras clave por respuesta (nombres de empresas, categorías, conceptos clave).",
              "Sin *, sin #, sin backticks, sin - para listas. Para listas de 2 o más items, use OBLIGATORIAMENTE el carácter • al inicio de cada línea, una línea por item. Ejemplo: • Item uno\n• Item dos\n• Item tres. Para una sola opción, puede usar '1.' o texto plano.",
              "Responda SIEMPRE en español neutro. No mezcle palabras en inglés con español. Las únicas excepciones son siglas técnicas estándar (URL, API, PDF).",
              "Si el usuario responde 'sí' a una pregunta tuya, no asuma que quiere más información. Tómelo como confirmación de que leyó su respuesta y termine ahí.",
              "No haga preguntas de seguimiento ('¿le gustaría saber más?', '¿le interesa alguna categoría?') cuando el tema está fuera de su alcance. Responda solo la pregunta del usuario y termine. Si el usuario quiere más información, él/ella va a preguntar.",
              "",
              "CÓMO RESPONDER:",
              "Preguntas amplias ('qué empresas hay', 'qué cursos ofrecen'): dé un resumen corto y ofrezca profundizar en algo específico. No liste todo de golpe.",
              "Preguntas específicas ('qué hace equipetrol', 'cuánto cuesta el curso X'): dé la respuesta completa con todos los detalles que tenga.",
              "",
              "EJEMPLO:",
              "Usuario: ¿Qué empresas son afiliadas?",
              "Asistente: La CBHE tiene **51 empresas afiliadas** en **6 categorías**: Exploración y Producción (12), Servicios en Pozo (12), Servicios en Superficie (12), Industria y Transporte (3), Servicios Auxiliares (11) y Adherentes (1). ¿Le interesa alguna categoría en particular?",
              "Usuario: ¿Qué hace Repsol?",
              "Asistente: **Repsol E&P Bolivia S.A.** se dedica a la **exploración y producción de hidrocarburos**. Opera en el **bloque Caipipendi**, que incluye el campo Margarita-Huacaya, uno de los mayores productores de gas natural de Bolivia, en el subandino sur.",
              "Usuario: Dame la lista de Servicios en Superficie.",
              "Asistente: **Servicios en Superficie** (12 empresas):",
              "1. BOLPEGAS S.R.L.",
              "2. CARLOS CABALLERO S.A.",
              "3. CONFIPETROL S.A. SUCURSAL BOLIVIA",
              "(sigue con el resto, numeradas)",
              "Para detalles de alguna empresa en particular, dígame el nombre.",
              "",
              "Fuente de verdad:\n",
              chatbotContext,
        ].join("\n");

        const ESTILOS = `
          #cbhe-chat * { box-sizing: border-box; }
          #cbhe-chat-btn { position: fixed; bottom: 24px; right: 24px; z-index: 99998; width: 58px; height: 58px; border-radius: 50%; background: #01406c; border: none; cursor: pointer; box-shadow: 0 4px 20px rgba(0,0,0,.28); display: flex; align-items: center; justify-content: center; transition: transform .2s ease; }
          #cbhe-chat-btn:hover { transform: scale(1.09); }
          #cbhe-chat-btn svg { width: 26px; height: 26px; fill: #fff; }
          #cbhe-chat-btn .icono-cerrar { display: none; font-size: 26px; color: #fff; line-height: 1; font-family: system-ui, sans-serif; }
          #cbhe-chat.abierto #cbhe-chat-btn .icono-chat { display: none; }
          #cbhe-chat.abierto #cbhe-chat-btn .icono-cerrar { display: block; }
          #cbhe-chat-panel { position: fixed; bottom: 94px; right: 24px; z-index: 99999; width: 380px; max-width: calc(100vw - 32px); background: #fff; border-radius: 20px; box-shadow: 0 8px 40px rgba(0,0,0,.18); display: flex; flex-direction: column; overflow: hidden; transform-origin: bottom right; transition: opacity .22s ease, transform .22s ease; }
          #cbhe-chat-panel.oculto { opacity: 0; transform: scale(.9) translateY(12px); pointer-events: none; }
          #cbhe-chat-cabecera { background: #01406c; color: #fff; padding: 12px 16px; display: flex; align-items: center; gap: 10px; }
          #cbhe-chat-cabecera .avatar { font-size: 22px; line-height: 1; }
          #cbhe-chat-cabecera .info { flex: 1; min-width: 0; }
          #cbhe-chat-cabecera .nombre { font-weight: 700; font-size: 15px; font-family: Outfit, system-ui, sans-serif; }
          #cbhe-chat-cabecera .sub { font-size: 12px; color: rgba(255,255,255,.72); margin-top: 1px; }
          #cbhe-chat-cerrar { background: rgba(255,255,255,.18); border: none; color: #fff; cursor: pointer; border-radius: 6px; padding: 4px 8px; font-size: 14px; line-height: 1; }
          #cbhe-chat-cerrar:hover { background: rgba(255,255,255,.32); }
          #cbhe-chat-mensajes { flex: 1; overflow-y: auto; padding: 12px; display: flex; flex-direction: column; gap: 10px; max-height: 360px; min-height: 120px; font-family: "DM Sans", system-ui, sans-serif; }
          .cbhe-fila { display: flex; align-items: flex-end; gap: 7px; }
          .cbhe-fila.user { flex-direction: row-reverse; }
          .cbhe-avatar { font-size: 18px; line-height: 1; margin-bottom: 2px; }
          .cbhe-burbuja { max-width: 78%; padding: 9px 13px; border-radius: 12px; font-size: 14px; line-height: 1.55; word-break: break-word; }
          .cbhe-burbuja.user { background: #01406c; color: #fff; border-bottom-right-radius: 3px; }
          .cbhe-burbuja.assistant { background: #f1f5f9; color: #1e293b; border-bottom-left-radius: 3px; white-space: pre-wrap; }
          .cbhe-burbuja.assistant strong { font-weight: 700; color: #01406c; }
          .cbhe-burbuja.assistant a { color: #01406c; text-decoration: underline; word-break: break-all; }
          .cbhe-escribiendo { display: flex; gap: 4px; align-items: center; padding: 10px 13px; background: #f1f5f9; border-radius: 12px; border-bottom-left-radius: 3px; width: fit-content; }
          .cbhe-escribiendo span { width: 7px; height: 7px; border-radius: 50%; background: #94a3b8; animation: cbhe-bounce .9s infinite; }
          .cbhe-escribiendo span:nth-child(2) { animation-delay: .18s; }
          .cbhe-escribiendo span:nth-child(3) { animation-delay: .36s; }
          @keyframes cbhe-bounce { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-6px); } }
          #cbhe-chat-pie { padding: 10px 12px; border-top: 1px solid #e2e8f0; display: flex; gap: 8px; align-items: center; background: #fff; }
          #cbhe-chat-texto { flex: 1; border: 1.5px solid #e2e8f0; border-radius: 10px; padding: 9px 12px; font-size: 14px; outline: none; color: #1e293b; font-family: "DM Sans", system-ui, sans-serif; }
          #cbhe-chat-texto:focus { border-color: #01406c; }
          #cbhe-chat-enviar { background: #01406c; color: #fff; border: none; border-radius: 10px; width: 38px; height: 38px; cursor: pointer; font-size: 18px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
          #cbhe-chat-enviar:hover { opacity: .88; }
          #cbhe-chat-enviar:disabled { opacity: .4; cursor: not-allowed; }
        `;
        const estilo = document.createElement("style");
        estilo.textContent = ESTILOS;
        document.head.appendChild(estilo);

        const raiz = document.createElement("div");
        raiz.id = "cbhe-chat";
        raiz.innerHTML = [
          '<button id="cbhe-chat-btn" type="button" aria-label="Abrir asistente" aria-expanded="false">',
          '<svg class="icono-chat" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 2H4a2 2 0 0 0-2 2v18l4-4h14a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2z"/></svg>',
          '<span class="icono-cerrar" aria-hidden="true">\u00D7</span>',
          "</button>",
          '<div id="cbhe-chat-panel" class="oculto" role="dialog" aria-label="Asistente virtual CBHE">',
          '<div id="cbhe-chat-cabecera">',
          '<div class="avatar" aria-hidden="true">\u26A1</div>',
          '<div class="info"><div class="nombre">CBHE</div><div class="sub">Asistente virtual</div></div>',
          '<button id="cbhe-chat-cerrar" type="button" aria-label="Cerrar asistente">\u00D7</button>',
          "</div>",
          '<div id="cbhe-chat-mensajes" role="log" aria-live="polite"></div>',
          '<div id="cbhe-chat-pie">',
          '<input id="cbhe-chat-texto" type="text" placeholder="Escriba su mensaje\u2026" autocomplete="off" aria-label="Mensaje" />',
          '<button id="cbhe-chat-enviar" type="button" aria-label="Enviar mensaje">\u2191</button>',
          "</div>",
          "</div>",
        ].join("");
        document.body.appendChild(raiz);

        const boton = document.getElementById("cbhe-chat-btn");
        const panel = document.getElementById("cbhe-chat-panel");
        const botonCerrar = document.getElementById("cbhe-chat-cerrar");
        const lista = document.getElementById("cbhe-chat-mensajes");
        const entrada = document.getElementById("cbhe-chat-texto");
        const botonEnviar = document.getElementById("cbhe-chat-enviar");

        const historial = [{ role: "system", content: systemPrompt }];
        let ocupado = false;
        let controlador = null;

        function desplazar() {
          lista.scrollTop = lista.scrollHeight;
        }

        function formatear(texto) {
          return formatBold(formatUrls(escapeHtmlPreservingNewlines(normalizeAssistantText(texto))));
        }

        function agregarBurbuja(rol, texto) {
          const fila = document.createElement("div");
          fila.className = "cbhe-fila " + rol;
          if (rol === "assistant") {
            const avatar = document.createElement("div");
            avatar.className = "cbhe-avatar";
            avatar.textContent = "\u26A1";
            fila.appendChild(avatar);
          }
          const burbuja = document.createElement("div");
          burbuja.className = "cbhe-burbuja " + rol;
          if (rol === "assistant") burbuja.innerHTML = formatear(texto);
          else burbuja.textContent = texto;
          fila.appendChild(burbuja);
          lista.appendChild(fila);
          desplazar();
          return burbuja;
        }

        function burbujaEscribiendo() {
          const fila = document.createElement("div");
          fila.className = "cbhe-fila assistant";
          const avatar = document.createElement("div");
          avatar.className = "cbhe-avatar";
          avatar.textContent = "\u26A1";
          const puntos = document.createElement("div");
          puntos.className = "cbhe-escribiendo";
          puntos.innerHTML = "<span></span><span></span><span></span>";
          fila.appendChild(avatar);
          fila.appendChild(puntos);
          lista.appendChild(fila);
          desplazar();
          return fila;
        }

        function alternar() {
          const abierto = raiz.classList.toggle("abierto");
          panel.classList.toggle("oculto", !abierto);
          boton.setAttribute("aria-expanded", String(abierto));
          if (abierto) entrada.focus();
        }

        boton.addEventListener("click", alternar);
        botonCerrar.addEventListener("click", alternar);

        async function enviarMensaje() {
          const texto = entrada.value.trim();
          if (!texto || ocupado) return;
          entrada.value = "";
          ocupado = true;
          botonEnviar.disabled = true;
          agregarBurbuja("user", texto);
          historial.push({ role: "user", content: texto });
          const escribiendo = burbujaEscribiendo();
          let acumulado = "";
          let burbujaIA = null;
          try {
            controlador = new AbortController();
            const respuesta = await fetch(chatEndpoint, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ messages: historial, maxTokens: 1024, temperature: 0.7 }),
              signal: controlador.signal,
            });
            if (!respuesta.ok || !respuesta.body) {
              throw new Error("El asistente no está disponible en este momento.");
            }
            escribiendo.remove();
            burbujaIA = agregarBurbuja("assistant", "");
            const lector = respuesta.body.getReader();
            const decodificador = new TextDecoder("utf-8");
            let buffer = "";
            for (;;) {
              const { done, value } = await lector.read();
              if (done) break;
              buffer += decodificador.decode(value, { stream: true });
              const lineas = buffer.split("\n");
              buffer = lineas.pop() || "";
              for (const linea of lineas) {
                const limpia = linea.trim();
                if (!limpia || limpia.indexOf("data:") !== 0) continue;
                const dato = limpia.slice(5).trim();
                if (!dato || dato === "[DONE]") continue;
                try {
                  const trozo = JSON.parse(dato).choices?.[0]?.delta?.content || "";
                  if (trozo) {
                    acumulado += trozo;
                    burbujaIA.innerHTML = formatear(acumulado);
                    desplazar();
                  }
                } catch {
                  // chunk incompleto: se completa en la próxima vuelta
                }
              }
            }
            if (acumulado) {
              historial.push({ role: "assistant", content: acumulado });
            } else if (burbujaIA) {
              burbujaIA.innerHTML = formatear("No obtuve respuesta. Intente de nuevo.");
            }
          } catch (err) {
            if (escribiendo.isConnected) escribiendo.remove();
            const mensaje = err && err.message ? err.message : "Ocurrió un error.";
            if (burbujaIA) burbujaIA.innerHTML = formatear("\u26A0\uFE0F " + mensaje);
            else agregarBurbuja("assistant", "\u26A0\uFE0F " + mensaje);
          } finally {
            controlador = null;
            ocupado = false;
            botonEnviar.disabled = false;
            entrada.focus();
          }
        }

        botonEnviar.addEventListener("click", enviarMensaje);
        entrada.addEventListener("keydown", function (e) {
          if (e.key === "Enter" && !e.shiftKey) {
            e.preventDefault();
            enviarMensaje();
          }
        });

        agregarBurbuja("assistant", "¡Hola! Pregúnteme sobre las empresas afiliadas o las capacitaciones de la CBHE.");

        // Normaliza el texto del asistente y lo convierte a HTML seguro.
        // La salida del modelo se renderiza con innerHTML, así que primero se
        // escapa y luego se aplican negritas, URLs y viñetas de forma controlada.
        function normalizeAssistantText(raw) {
          if (!raw) return raw;
          return raw
            // italic *text* or _text_ → text (only when not part of a word)
            .replace(/(^|[\s(])_([^_\n]+)_(?=[\s).,!?]|$)/g, "$1$2")
            .replace(/(^|[\s(])\*([^*\n]+)\*(?=[\s).,!?]|$)/g, "$1$2")
            // inline code `text` → text
            .replace(/`([^`\n]+)`/g, "$1")
            // headers at line start: "## Title" → "Title"
            .replace(/^#{1,6}\s+/gm, "")
            // bullet markers at line start: "- item" or "* item" → "• item"
            .replace(/^[\s]*[-\*]\s+/gm, "• ")
            // collapse 3+ blank lines into 2
            .replace(/\n{3,}/g, "\n\n")
            .trim();
        }

        // Convert **word** to <strong>word</strong> for keyword emphasis.
        // Must run AFTER escapeHtml so ** aren't converted to entities first.
        function formatBold(s) {
          // Convert paired **word** to <strong>word</strong>, then strip any
          // residual unmatched ** markers (spec R5). Order is important:
          // matched pairs are converted first, then orphans are removed.
          return s.replace(/\*\*([^*\n][^*]*?)\*\*/g, "<strong>$1</strong>").replace(/\*{2,}/g, "");
        }

        // Format a bare URL as "Web: dominio" so it stands out from prose
        function formatUrls(html) {
          return html.replace(
            /(?<!["'>])(https?:\/\/[^\s<]+)/g,
            (m) => {
              try {
                const u = new URL(m);
                return `Web: <a class="sgq-link" href="${m}" target="_blank" rel="noopener">${u.hostname.replace(/^www\./, "")}</a>`;
              } catch {
                return m;
              }
            },
          );
        }

        function escapeHtmlPreservingNewlines(s) {
          return s
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            // Restore URLs after escape: formatUrls will re-anchor them via the link.
            // We need to keep newlines as <br> for HTML display.
            .replace(/\n/g, "<br>");
        }

      })();
    </script>
  </body>
</html>
