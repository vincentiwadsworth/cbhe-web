---
import "../styles/global.css";
import CursorGlow from "../components/CursorGlow.astro";
import { getCollection } from "astro:content";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Path relativo SIN base — ej: "quienes-somos" o "novedades/proyecto-x1" */
  currentPath?: string;
  noindex?: boolean;
  ogType?: string;
  /** Article JSON-LD: fecha de publicación */
  datePublished?: string;
  /** Article JSON-LD: fecha de modificación */
  dateModified?: string;
  /** Article JSON-LD: autor */
  author?: string;
}

const {
  title,
  description,
  image,
  currentPath,
  noindex,
  ogType = "website",
  datePublished,
  dateModified,
  author = "CBHE",
} = Astro.props;

const baseHref = import.meta.env.BASE_URL === '/'
  ? import.meta.env.SITE
  : `${import.meta.env.SITE}${import.meta.env.BASE_URL}/`;

const groqKey = import.meta.env.GROQ_KEY ?? "";

// Build company knowledge base for the chatbot
const grupoLabels: Record<string, string> = {
  upstream: "Exploración y Producción",
  pozo: "Servicios en Pozo",
  superficie: "Servicios en Superficie",
  downstream: "Industria y Transporte",
  auxiliares: "Servicios Auxiliares",
  adherentes: "Adherentes",
};
const todasEmpresas = await getCollection("empresas", ({ data }) => !data.draft);
const empresasByGrupo = Object.entries(grupoLabels)
  .map(([key, label]) => {
    const items = todasEmpresas
      .filter((e) => e.data.grupo === key)
      .map((e) => {
        let line = `- ${e.data.nombre}${e.data.website ? ` (${e.data.website})` : ""}`;
        if (e.data.description) line += `: ${e.data.description}`;
        return line;
      });
    return items.length > 0 ? `${label} (${items.length}):\n${items.join("\n")}` : "";
  })
  .filter(Boolean)
  .join("\n\n");
const empresasContext = `Empresas afiliadas a la CBHE:\n\n${empresasByGrupo}`;

// Build courses knowledge base for the chatbot
const todosCursos = await getCollection("cursos", ({ data }) => !data.draft);
const cursosContext = todosCursos.length > 0
  ? "Capacitaciones de la CBHE:\n\n" + todosCursos.map((c) => {
      const parts = [`- ${c.data.title} (${c.data.category}, ${c.data.modality})`];
      parts.push(`  Inicio: ${c.data.startDate}`);
      parts.push(`  Precio: ${c.data.price}`);
      if (c.data.description) parts.push(`  ${c.data.description.slice(0, 150)}`);
      return parts.join("\n");
    }).join("\n\n")
  : "";

const chatbotContext = [empresasContext, cursosContext].filter(Boolean).join("\n\n");

// Canonical URL: Astro.url ya incluye site + base + path
const canonicalUrl = Astro.url.href;

// Open Graph: absolute URLs for images (required by social platforms)
const ogImageUrl = new URL(image || 'og-default.png', baseHref).href;
// Square fallback for WhatsApp — WhatsApp usa el último og:image tag y prefiere 1:1
const ogImageSquareUrl = new URL('og-default-square.png', baseHref).href;

// Breadcrumb: infer from currentPath segments
const breadcrumbSegments: { name: string; href: string }[] = [];
if (currentPath) {
  const segments = currentPath.split("/").filter(Boolean);
  let acc = "";
  for (const seg of segments) {
    acc += `/${seg}`;
    // prettier names
    const nameMap: Record<string, string> = {
      "novedades": "Novedades",
      "capacitacion": "Capacitación",
    };
    const name = nameMap[seg] ?? seg.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
    breadcrumbSegments.push({ name, href: acc });
  }
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#00507e" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1012" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <!-- Prevent flash of wrong theme: apply dark class BEFORE first paint -->
    <script is:inline>
      (function(){var e=localStorage.getItem('theme');if(e==='dark'||(!e&&window.matchMedia('(prefers-color-scheme:dark)').matches))document.documentElement.classList.add('dark');setTimeout(function(){document.documentElement.classList.add('theme-transition-ready')},100)})();
    </script>
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <base href={baseHref} />
    <!-- Favicon stack -->
    <link rel="icon" href="favicon-cbhe.svg" type="image/svg+xml" />
    <link rel="icon" href="favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="site.webmanifest" />
    <link rel="preconnect" href="https://lh3.googleusercontent.com" />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://api.web3forms.com" />
    {description && <meta name="description" content={description} />}
    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | CBHE`} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Square fallback: WhatsApp usa el último og:image y prefiere 1:1 -->
    <meta property="og:image" content={ogImageSquareUrl} />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="800" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="CBHE" />
    <meta property="og:locale" content="es_BO" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@CBHEnergia" />
    <meta name="twitter:title" content={`${title} | CBHE`} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />
    <title>{title} | CBHE</title>
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "name": "CBHE — Cámara Boliviana de Hidrocarburos y Energía",
          "url": baseHref,
          "logo": new URL("logo-cbhe.webp", baseHref).href,
          "sameAs": [
            "https://www.facebook.com/CBHEnergia",
            "https://www.linkedin.com/company/c%C3%A1mara-boliviana-de-hidrocarburos-y-energ%C3%ADa",
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "email": "cbhe@cbhe.org.bo",
            "contactType": "customer service",
          },
        },
        {
          "@type": "WebSite",
          "name": "CBHE",
          "url": baseHref,
          "description": description || "Cámara Boliviana de Hidrocarburos y Energía — Integramos energías con liderazgo e innovación.",
          "inLanguage": "es-BO",
        },
        ...(breadcrumbSegments.length > 0 ? [{
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Inicio", "item": baseHref },
            ...breadcrumbSegments.map((seg, i) => ({
              "@type": "ListItem",
              "position": i + 2,
              "name": seg.name,
              "item": new URL(seg.href.replace(/^\//, ""), baseHref).href,
            })),
          ],
        }] : []),
        ...(image ? [{
          "@type": "ImageObject",
          "url": ogImageUrl,
          "caption": title,
        }] : []),
        ...(datePublished ? [{
          "@type": "Article",
          "headline": title,
          "description": description,
          "image": ogImageUrl,
          "author": { "@type": "Organization", "name": author },
          "datePublished": datePublished,
          ...(dateModified ? { "dateModified": dateModified } : {}),
          "publisher": {
            "@type": "Organization",
            "name": "CBHE — Cámara Boliviana de Hidrocarburos y Energía",
            "logo": { "@type": "ImageObject", "url": new URL("logo-cbhe.webp", baseHref).href },
          },
        }] : []),
      ],
    })} />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-primary focus:text-on-primary focus:px-4 focus:py-2 focus:rounded-sm"
    >
      Saltar al contenido principal
    </a>
    <CursorGlow />
    <slot />

    <!-- AI Chatbot (multi-ai-sdk) -->
    <script is:inline define:vars={{ groqKey, chatbotContext }}>
      if (groqKey) {
        import("https://esm.sh/multi-ai-sdk").then(function (mod) {
          mod.embedChat({
            provider: "groq",
            apiKey: groqKey,

            assistantName: "CBHE",
            assistantAvatar: "⚡",
            title: "CBHE",
            subtitle: "Asistente virtual",
            welcomeMessage: "¡Hola! Preguntame sobre las empresas afiliadas o las capacitaciones de la CBHE.",
            suggestedQuestions: [
              "¿Qué empresas son afiliadas?",
              "¿Qué capacitaciones ofrecen?",
            ],

            model: "llama-3.3-70b-versatile",
            maxTokens: 1024,
            temperature: 0.7,

            systemPrompt: [
              "Sos el asistente virtual de la CBHE (Cámara Boliviana de Hidrocarburos y Energía). Respondé en español, de forma profesional pero cercana.",
              "",
              "REGLAS:",
              "Si no sabés algo, sugerí contactar a cbhe@cbhe.org.bo.",
              "NUNCA inventes información. Si no tenés datos sobre un tema específico en la 'Fuente de verdad', no inventes listas, beneficios, procesos ni ningún hecho. Informá que no tenés esa información y sugerí contactar a cbhe@cbhe.org.bo.",
              "FORMATO: usá texto plano con saltos de línea. NO uses Markdown excepto **palabra** para enfatizar 1-3 palabras clave por respuesta (nombres de empresas, categorías, conceptos clave).",
              "Sin *, sin #, sin backticks, sin - para listas. Usá '1.' '2.' o el carácter • para listas.",
              "Respondé SIEMPRE en español neutro. No mezcles palabras en inglés con español. Las únicas excepciones son siglas técnicas estándar (URL, API, PDF).",
              "Si el usuario responde 'sí' a una pregunta tuya, no asumas que quiere más información. Tomalo como confirmación de que leyó tu respuesta y terminá ahí.",
              "No hagas preguntas de seguimiento ('¿te gustaría saber más?', '¿te interesa alguna categoría?') cuando el tema está fuera de tu alcance. Respondé solo la pregunta del usuario y terminá. Si el usuario quiere más información, él/ella va a preguntar.",
              "",
              "CÓMO RESPONDER:",
              "Preguntas amplias ('qué empresas hay', 'qué cursos ofrecen'): dale un resumen corto y ofrecé profundizar en algo específico. No listes todo de golpe.",
              "Preguntas específicas ('qué hace equipetrol', 'cuánto cuesta el curso X'): dale la respuesta completa con todos los detalles que tengas.",
              "",
              "EJEMPLO:",
              "Usuario: ¿Qué empresas son afiliadas?",
              "Asistente: La CBHE tiene **51 empresas afiliadas** en **6 categorías**: Exploración y Producción (12), Servicios en Pozo (12), Servicios en Superficie (12), Industria y Transporte (3), Servicios Auxiliares (11) y Adherentes (1). ¿Te interesa alguna categoría en particular?",
              "Usuario: ¿Qué hace Repsol?",
              "Asistente: **Repsol E&P Bolivia S.A.** se dedica a la **exploración y producción de hidrocarburos**. Opera en el **bloque Caipipendi**, que incluye el campo Margarita-Huacaya, uno de los mayores productores de gas natural de Bolivia, en el subandino sur.",
              "Usuario: Dame la lista de Servicios en Superficie.",
              "Asistente: **Servicios en Superficie** (12 empresas):",
              "1. BOLPEGAS S.R.L.",
              "2. CARLOS CABALLERO S.A.",
              "3. CONFIPETROL S.A. SUCURSAL BOLIVIA",
              "(sigue con el resto, numeradas)",
              "Para detalles de alguna empresa en particular, decime el nombre.",
              "",
              "Fuente de verdad:\n",
              chatbotContext,
            ].join("\n"),

            position: "bottom-right",
            theme: {
              primaryColor: "#01406c",
              fontFamily: "Inter, system-ui, sans-serif",
              fontSize: 14,
              borderRadius: 20,
              width: 380,
              messagesHeight: 360,
              darkMode: false,
            },
            customCss: `
              .sgq-msg {
                white-space: pre-wrap;
                line-height: 1.55;
                padding: 11px 14px;
              }
              .sgq-msg.assistant {
                max-width: 85%;
              }
              a.sgq-link {
                color: #01406c;
                text-decoration: underline;
                word-break: break-all;
              }
              .sgq-msg strong {
                font-weight: 700;
                color: #01406c;
              }
            `,
            controls: {
              modelSwitcher: false,
              temperatureControl: false,
              maxTokensControl: false,
              showTokenUsage: false,
              allowClear: true,
              allowCopy: true,
              allowExport: false,
            },
          });
        });

        // Post-process chatbot output: strip residual markdown that leaks through
        // (the widget uses textContent so it can't render formatting, but the LLM
        // still emits * / ** / ` / - markers occasionally).
        // We observe #sgq-messages and normalize any new assistant bubble.
        function normalizeAssistantText(raw) {
          if (!raw) return raw;
          return raw
            // italic *text* or _text_ → text (only when not part of a word)
            .replace(/(^|[\s(])_([^_\n]+)_(?=[\s).,!?]|$)/g, "$1$2")
            .replace(/(^|[\s(])\*([^*\n]+)\*(?=[\s).,!?]|$)/g, "$1$2")
            // inline code `text` → text
            .replace(/`([^`\n]+)`/g, "$1")
            // headers at line start: "## Title" → "Title"
            .replace(/^#{1,6}\s+/gm, "")
            // bullet markers at line start: "- item" or "* item" → "• item"
            .replace(/^[\s]*[-\*]\s+/gm, "• ")
            // collapse 3+ blank lines into 2
            .replace(/\n{3,}/g, "\n\n")
            .trim();
        }

        // Convert **word** to <strong>word</strong> for keyword emphasis.
        // Must run AFTER escapeHtml so ** aren't converted to entities first.
        function formatBold(s) {
          // Convert paired **word** to <strong>word</strong>, then strip any
          // residual unmatched ** markers (spec R5). Order is important:
          // matched pairs are converted first, then orphans are removed.
          return s.replace(/\*\*([^*\n][^*]*?)\*\*/g, "<strong>$1</strong>").replace(/\*{2,}/g, "");
        }

        // Format a bare URL as "Web: dominio" so it stands out from prose
        function formatUrls(html) {
          return html.replace(
            /(?<!["'>])(https?:\/\/[^\s<]+)/g,
            (m) => {
              try {
                const u = new URL(m);
                return `Web: <a class="sgq-link" href="${m}" target="_blank" rel="noopener">${u.hostname.replace(/^www\./, "")}</a>`;
              } catch {
                return m;
              }
            },
          );
        }

        function postProcessBubble(bubble) {
          // Collect raw text from the SDK's live text node(s). We look at direct
          // children only (no recursion) because the SDK writes a single text node
          // as a direct child of the bubble, before .sgq-copy-btn.
          let raw = "";
          const existingSpan = bubble.querySelector(".sgq-msg-normalized");
          for (const child of bubble.childNodes) {
            if (child.nodeType === 3) raw += child.nodeValue;
          }
          if (!raw && !existingSpan) return;
          if (existingSpan && raw === existingSpan.dataset.lastRaw) return;

          if (existingSpan) {
            // Update existing span in-place (no re-create) to avoid reflow cascade
            existingSpan.dataset.lastRaw = raw;
            existingSpan.innerHTML = formatBold(formatUrls(escapeHtmlPreservingNewlines(normalizeAssistantText(raw))));
            // Remove stray raw text nodes added by SDK post-formatting
            for (const child of bubble.childNodes) {
              if (child.nodeType === 3) bubble.removeChild(child);
            }
            return;
          }

          // First-time processing: build the wrapper span
          const copyBtn = bubble.querySelector(".sgq-copy-btn");
          const normalized = normalizeAssistantText(raw);
          // Order matters: escape → bold (uses * as anchor) → URLs (already-safe)
          const html = formatBold(formatUrls(escapeHtmlPreservingNewlines(normalized)));

          // Remove ALL existing children except copyBtn
          const children = Array.from(bubble.childNodes);
          for (const child of children) {
            if (child !== copyBtn) bubble.removeChild(child);
          }

          // Build a wrapper span with the normalized HTML
          const wrapper = document.createElement("span");
          wrapper.className = "sgq-msg-normalized";
          wrapper.innerHTML = html;

          // Insert wrapper as first child (or before copyBtn if it exists)
          if (copyBtn) {
            bubble.insertBefore(wrapper, copyBtn);
          } else {
            bubble.appendChild(wrapper);
          }
        }

        function escapeHtmlPreservingNewlines(s) {
          return s
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            // Restore URLs after escape: formatUrls will re-anchor them via the link.
            // We need to keep newlines as <br> for HTML display.
            .replace(/\n/g, "<br>");
        }

        // Wait for #sgq-messages to appear, then observe
        function attachObserver() {
          const messagesEl = document.getElementById("sgq-messages");
          if (!messagesEl) {
            setTimeout(attachObserver, 100);
            return;
          }
          const observer = new MutationObserver((mutations) => {
            for (const m of mutations) {
              if (m.type === "childList") {
                m.addedNodes.forEach((node) => {
                  if (node.nodeType === 1) {
                    // Newly added assistant bubble (or row containing it)
                    const bubbles = node.classList?.contains("sgq-msg")
                      ? [node]
                      : node.querySelectorAll?.(".sgq-msg") || [];
                    bubbles.forEach((b) => {
                      if (b.classList.contains("assistant")) {
                        // Defer to allow streaming text nodes to be inserted
                        setTimeout(() => postProcessBubble(b), 50);
                      }
                    });
                  } else if (node.nodeType === 3) {
                    // Streaming: SDK removes old text node and inserts a new one
                    // (characterData does not fire; we catch it here via childList)
                    const bubble = node.parentElement?.closest(".sgq-msg");
                    if (bubble?.classList.contains("assistant")) {
                      clearTimeout(bubble._normTimer);
                      bubble._normTimer = setTimeout(() => postProcessBubble(bubble), 200);
                    }
                  }
                });
              } else if (m.type === "characterData") {
                // Streaming: text node inside a bubble mutated
                const bubble = m.target.parentElement?.closest(".sgq-msg");
                if (bubble && bubble.classList.contains("assistant")) {
                  // Debounce: wait for the stream chunk to finish before re-processing
                  clearTimeout(bubble._normTimer);
                  bubble._normTimer = setTimeout(() => postProcessBubble(bubble), 200);
                }
              }
            }
          });
          observer.observe(messagesEl, {
            childList: true,
            subtree: true,
            characterData: true,
          });
        }
        attachObserver();
      }
    </script>
  </body>
</html>
