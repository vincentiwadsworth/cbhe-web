---

<PageLayout
  title="Afiliación"
  description="Requisitos, proceso de aprobación y beneficios de afiliarse a la Cámara Boliviana de Hidrocarburos y Energía. Conozca la documentación necesaria para formar parte de la institución líder del sector energético."
  active="afiliacion"
>
  <!-- Hero: unique dark variant, not SubpageHero -->
  <header class="relative bg-inverse-surface overflow-hidden">
    <div class="absolute inset-0 bg-primary/20"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 md:px-8 py-16 sm:py-20 md:py-24">
      <div class="max-w-3xl">
        <p class="text-primary-fixed-dim font-semibold text-sm tracking-wider uppercase mb-4">
          Afiliación
        </p>
        <h1 class="text-inverse-on-surface font-headline font-extrabold text-3xl sm:text-4xl md:text-5xl leading-tight mb-6">
          Requisitos de afiliación
        </h1>
        <p class="text-inverse-on-surface/80 font-body text-base md:text-lg leading-relaxed max-w-2xl">
          Conozca la documentación necesaria para afiliarse, el proceso de aprobación y los beneficios
          de formar parte de la CBHE.
        </p>
      </div>
    </div>
  </header>

  <!-- Documentación necesaria -->
  <Section bg="surface">
    <SectionHeading
      title="Documentación necesaria"
      description="Los documentos se entregan en fotocopia simple o de manera digital para su revisión y aprobación."
    />

    <!-- Empresas nacionales -->
    <div class="mb-14">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 bg-primary-container rounded-lg flex items-center justify-center shrink-0">
          <Icon name="material-symbols:description" class="text-on-primary size-6" />
        </div>
        <h3 class="font-headline font-bold text-xl text-on-surface">Empresas nacionales</h3>
      </div>
      <ol class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {docsNacionales.map((doc, i) => (
          <li class="bg-surface-container-low rounded-lg p-6 border border-outline-variant/30 flex gap-4 items-start h-full">
            <span class="shrink-0 w-8 h-8 bg-primary-container rounded-md flex items-center justify-center text-on-primary font-bold text-sm mt-0.5">
              {i + 1}
            </span>
            <p class="text-on-surface text-sm leading-relaxed">{doc}</p>
          </li>
        ))}
      </ol>
    </div>

    <!-- Empresas extranjeras -->
    <div class="mb-14">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 bg-primary-container rounded-lg flex items-center justify-center shrink-0">
          <Icon name="material-symbols:language" class="text-on-primary size-6" />
        </div>
        <h3 class="font-headline font-bold text-xl text-on-surface">Empresas extranjeras</h3>
      </div>
      <ol class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {docsExtranjeros.map((doc, i) => (
          <li class="bg-surface-container-low rounded-lg p-6 border border-outline-variant/30 flex gap-4 items-start h-full">
            <span class="shrink-0 w-8 h-8 bg-primary-container rounded-md flex items-center justify-center text-on-primary font-bold text-sm mt-0.5">
              {i + 1}
            </span>
            <div>
              <p class="font-headline font-semibold text-on-surface text-sm mb-1">{doc.titulo}</p>
              <p class="text-on-surface-variant text-sm leading-relaxed">{doc.descripcion}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <!-- Nota: consideraciones para empresas extranjeras -->
    <div class="bg-primary-container/15 rounded-lg border border-primary-container/40 p-6 flex items-start gap-4">
      <div class="w-8 h-8 bg-primary-container rounded-lg flex items-center justify-center shrink-0 mt-0.5">
        <Icon name="material-symbols:task-alt" class="text-on-primary size-5" />
      </div>
      <div>
        <h4 class="font-headline font-bold text-on-surface mb-2">Consideraciones para empresas extranjeras</h4>
        <ul class="text-on-surface-variant text-sm leading-relaxed space-y-2 list-disc pl-5">
          {consideracionesExtranjeras.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </Section>

  <!-- Proceso de aprobación -->
  <Section bg="surface-container-low">
    <SectionHeading
      title="Proceso de aprobación"
      description="La CBHE evalúa cada solicitud de afiliación en tres etapas, desde la revisión documental hasta la notificación del grupo asignado."
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-14">
      {pasosProceso.map((paso) => (
        <article class="bg-surface rounded-lg p-8 border border-outline-variant/30 shadow-sm hover:shadow-md hover:border-primary/30 transition-all duration-300 group flex flex-col items-start h-full">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-14 h-14 bg-primary-container rounded-lg flex items-center justify-center group-hover:scale-105 transition-transform">
              <Icon name={`material-symbols:${paso.icono}`} class="text-on-primary size-7" />
            </div>
            <span class="text-xs font-bold text-primary tracking-wider uppercase bg-primary-container/10 px-3 py-1 rounded-md">
              Paso {paso.numero}
            </span>
          </div>
          <h3 class="font-headline font-bold text-lg text-on-surface mb-3">{paso.titulo}</h3>
          <p class="text-on-surface-variant text-sm leading-relaxed">{paso.descripcion}</p>
        </article>
      ))}
    </div>

    <!-- Grupos de afiliación -->
    <div class="mb-14">
      <h3 class="font-headline font-bold text-xl text-on-surface mb-2">Grupos de afiliación</h3>
      <p class="text-on-surface-variant text-sm leading-relaxed mb-6">
        La categoría depende de la información presentada, la especialidad y el patrimonio de la empresa.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {gruposAfiliacion.map((grupo) => (
          <div class="bg-surface rounded-lg border border-outline-variant/30 p-4 flex items-center gap-3">
            <div class="w-10 h-10 bg-primary-container rounded-lg flex items-center justify-center shrink-0">
              <Icon name={`material-symbols:${grupo.icono}`} class="text-on-primary size-5" />
            </div>
            <p class="font-body font-medium text-on-surface text-sm leading-snug">{grupo.nombre}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Card de aportes -->
    <div class="bg-surface rounded-lg border border-outline-variant/30 p-6 flex items-start gap-4">
      <div class="w-8 h-8 bg-primary-container rounded-lg flex items-center justify-center shrink-0 mt-0.5">
        <Icon name="material-symbols:payments" class="text-on-primary size-5" />
      </div>
      <div>
        <h4 class="font-headline font-bold text-on-surface mb-1">Aportes de inscripción y mensuales</h4>
        <p class="text-on-surface-variant text-sm leading-relaxed">
          Los aportes de inscripción y mensuales varían según el grupo asignado y se informan
          directamente a cada empresa durante el proceso. Contáctese con nuestro equipo para más detalle.
        </p>
      </div>
    </div>
  </Section>

  <!-- Beneficios de la afiliación -->
  <Section bg="surface">
    <SectionHeading
      title="Beneficios de la afiliación"
      description="Las empresas afiliadas a la CBHE acceden a los siguientes beneficios."
    />
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {beneficios.map((beneficio) => (
        <article class="bg-surface-container-low rounded-lg p-8 border border-outline-variant/30 shadow-sm hover:shadow-md hover:border-primary/30 transition-all duration-300 group flex flex-col items-start h-full">
          <div class="w-14 h-14 bg-primary-container rounded-lg flex items-center justify-center mb-6 group-hover:scale-105 transition-transform">
            <Icon name={`material-symbols:${beneficio.icono}`} class="text-on-primary size-7" />
          </div>
          <h3 class="font-headline font-bold text-lg text-on-surface mb-3">{beneficio.titulo}</h3>
          <ul class="text-on-surface-variant text-sm leading-relaxed space-y-2 list-disc pl-5">
            {beneficio.puntos.map((punto) => <li>{punto}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </Section>

  <!-- CTA -->
  <CtaBanner
    icon="verified"
    title="¿Listo para afiliarse?"
    description="Si su empresa cumple con los requisitos, complete el formulario de afiliación y nuestro equipo se pondrá en contacto a la brevedad para guiarle en los siguientes pasos."
    variant="dark"
  >
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="../#afiliacion"
        class="bg-inverse-on-surface text-inverse-surface rounded-md px-8 py-4 font-bold hover:bg-surface-bright hover:shadow-md transition-all min-h-[44px] inline-flex items-center gap-2"
      >
        Completar formulario de afiliación
        <Icon name="material-symbols:arrow-forward" class="size-5" />
      </a>
      <a
        href="contacto"
        class="border-2 border-inverse-on-surface/40 text-inverse-on-surface rounded-md px-8 py-4 font-semibold hover:bg-inverse-on-surface/10 transition-all min-h-[44px] spring-press"
      >
        Hablar con el equipo
      </a>
    </div>
  </CtaBanner>
</PageLayout>
