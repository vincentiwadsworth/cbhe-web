---
/**
 * certificados.astro — Certificate verification page.
 *
 * Reads the `c` query parameter client-side and queries Supabase
 * to display certificate details. Three states: loading, found, not-found.
 * Works gracefully even without Supabase configured (shows error state).
 */
import PageLayout from "../layouts/PageLayout.astro";
import Section from "../components/Section.astro";
import Icon from "../components/Icon.astro";

const supabaseUrl = import.meta.env.VITE_SUPABASE_URL;
const supabaseKey = import.meta.env.VITE_SUPABASE_PUBLISHABLE_KEY;
---

<PageLayout title="Verificar Certificado" description="Verifique la autenticidad de un certificado emitido por la CBHE." noindex>
  <Section bg="surface-container-low">
    <div class="max-w-2xl mx-auto text-center">
      <div class="mb-8">
        <div class="inline-flex items-center justify-center size-16 rounded-full bg-primary-container mb-4">
          <Icon name="material-symbols:qr-code-2" class="size-8 text-primary" />
        </div>
        <h1 class="font-headline font-extrabold text-3xl sm:text-4xl text-on-surface mb-3">
          Verificación de Certificado
        </h1>
        <p class="text-on-surface-variant text-base sm:text-lg max-w-md mx-auto">
          Sistema automático de verificación de certificados CBHE.
        </p>
      </div>

      <!-- ===== State: Loading ===== -->
      <div id="cert-loading" class="py-12">
        <div class="flex flex-col items-center gap-4">
          <div class="size-12 rounded-full border-4 border-primary-container border-t-primary animate-spin"></div>
          <p class="text-on-surface-variant font-medium">Verificando certificado…</p>
          <p id="cert-code-display" class="font-mono text-sm text-primary bg-primary-container/40 rounded px-3 py-1"></p>
        </div>
      </div>

      <!-- ===== State: Found (rendered by JS) ===== -->
      <div id="cert-found" class="hidden">
        <div class="bg-surface rounded-lg shadow-md border border-outline-variant/30 overflow-hidden max-w-lg mx-auto text-left">
          <!-- Header — dynamic -->
          <div id="cert-header" class="px-6 py-4 flex items-center gap-3 bg-success/10">
            <Icon id="cert-estado-icon" name="material-symbols:verified" class="size-8 shrink-0 text-success" />
            <div class="min-w-0">
              <p id="cert-estado-title" class="font-headline font-bold text-on-surface text-lg leading-tight truncate">Certificado Verificado</p>
              <p id="cert-estado-desc" class="text-xs text-on-surface-variant mt-0.5">Este certificado es válido y está vigente.</p>
            </div>
          </div>

          <!-- Body -->
          <div class="px-6 py-5 space-y-4">
            <div>
              <p id="cert-label-primary" class="text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-1">Empresa</p>
              <p id="cert-primary" class="font-headline font-bold text-on-surface text-xl"></p>
            </div>

            <div>
              <p id="cert-label-secondary" class="text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-1">Tipo de Certificación</p>
              <p id="cert-secondary" class="text-on-surface"></p>
            </div>

            <div>
              <p class="text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-1">Fecha de Emisión</p>
              <p id="cert-emision" class="text-on-surface flex items-center gap-1.5">
                <Icon name="material-symbols:calendar-today" class="size-4 text-on-surface-variant" />
              </p>
            </div>

            <!-- QR Code (shown dynamically when qr_url is non-NULL) -->
            <div id="cert-qr" class="hidden pt-4 border-t border-outline-variant/30">
              <p class="text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-2 text-center">Código QR de Verificación</p>
              <div class="flex justify-center">
                <img id="cert-qr-img" src="" alt="Código QR de verificación" class="rounded-lg" style="max-width:200px;height:auto" />
              </div>
            </div>

            <div class="pt-3 border-t border-outline-variant/30">
              <p class="text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-1">Código de Verificación</p>
              <p id="cert-codigo" class="font-mono text-sm text-primary bg-primary-container/40 rounded px-3 py-1.5 inline-block select-all"></p>
            </div>
          </div>
        </div>
      </div>

      <!-- ===== State: Not Found ===== -->
      <div id="cert-not-found" class="hidden py-12">
        <div class="bg-surface rounded-lg shadow-md border border-error/20 overflow-hidden max-w-lg mx-auto">
          <div class="px-6 py-4 flex items-center gap-3 bg-error/10">
            <Icon name="material-symbols:security" class="size-8 text-error shrink-0" />
            <div>
              <p class="font-headline font-bold text-on-surface text-lg">Certificado No Encontrado</p>
              <p class="text-xs text-on-surface-variant mt-0.5">No se encontró ningún certificado con ese código.</p>
            </div>
          </div>
          <div class="px-6 py-5">
            <p class="text-on-surface-variant text-sm mb-4">
              El código de verificación no corresponde a ningún certificado registrado. Verifique el código e intente nuevamente.
            </p>
            <a
              href="verificar"
              class="inline-flex items-center gap-2 text-primary font-semibold hover:underline hover:underline-offset-4 transition-colors"
            >
              <Icon name="material-symbols:refresh" class="size-4" />
              Intentar con otro código
            </a>
          </div>
        </div>
      </div>

      <!-- ===== State: Error ===== -->
      <div id="cert-error" class="hidden py-12">
        <div class="bg-surface rounded-lg shadow-md border border-error/20 overflow-hidden max-w-lg mx-auto">
          <div class="px-6 py-4 flex items-center gap-3 bg-error/10">
            <Icon name="material-symbols:security" class="size-8 text-error shrink-0" />
            <div>
              <p class="font-headline font-bold text-on-surface text-lg">Error de Verificación</p>
              <p class="text-xs text-on-surface-variant mt-0.5">No se pudo verificar el certificado en este momento.</p>
            </div>
          </div>
          <div class="px-6 py-5">
            <p class="text-on-surface-variant text-sm mb-4">
              Ocurrió un error al intentar verificar el certificado. Esto puede deberse a un problema temporal del servicio. Por favor, intente nuevamente más tarde.
            </p>
            <a
              href="contacto"
              class="inline-flex items-center gap-2 text-primary font-semibold hover:underline hover:underline-offset-4 transition-colors"
            >
              <Icon name="material-symbols:mail" class="size-4" />
              Contactar a la CBHE
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script define:vars={{ supabaseUrl, supabaseKey }}>
  const loadingEl = document.getElementById("cert-loading");
  const foundEl = document.getElementById("cert-found");
  const notFoundEl = document.getElementById("cert-not-found");
  const errorEl = document.getElementById("cert-error");
  const codeDisplayEl = document.getElementById("cert-code-display");

  function hideAll() {
    loadingEl?.classList.add("hidden");
    foundEl?.classList.add("hidden");
    notFoundEl?.classList.add("hidden");
    errorEl?.classList.add("hidden");
  }

  function showState(state) {
    hideAll();
    switch (state) {
      case "loading":
        loadingEl?.classList.remove("hidden");
        break;
      case "found":
        foundEl?.classList.remove("hidden");
        break;
      case "not-found":
        notFoundEl?.classList.remove("hidden");
        break;
      case "error":
        errorEl?.classList.remove("hidden");
        break;
    }
  }

  function formatDate(dateStr) {
    try {
      const date = new Date(dateStr + "T00:00:00");
      return date.toLocaleDateString("es-BO", {
        day: "numeric",
        month: "long",
        year: "numeric",
      });
    } catch {
      return dateStr;
    }
  }

  function populateCard(cert, mapping) {
    const primaryLabelEl = document.getElementById("cert-label-primary");
    const primaryEl = document.getElementById("cert-primary");
    const secondaryLabelEl = document.getElementById("cert-label-secondary");
    const secondaryEl = document.getElementById("cert-secondary");
    const emisionEl = document.getElementById("cert-emision");
    const codigoEl = document.getElementById("cert-codigo");

    if (primaryLabelEl) primaryLabelEl.textContent = mapping.labels.primary;
    if (primaryEl) primaryEl.textContent = cert[mapping.fieldKeys.primary];
    if (secondaryLabelEl) secondaryLabelEl.textContent = mapping.labels.secondary;
    if (secondaryEl) secondaryEl.textContent = cert[mapping.fieldKeys.secondary];
    if (emisionEl) emisionEl.textContent = formatDate(cert.fecha_emision);

    // QR code: show when qr_url is non-NULL, hide + clear otherwise
    const qrEl = document.getElementById("cert-qr");
    const qrImgEl = document.getElementById("cert-qr-img");
    if (qrEl && qrImgEl) {
      if (cert.qr_url) {
        qrImgEl.src = cert.qr_url;
        qrEl.classList.remove("hidden");
      } else {
        qrEl.classList.add("hidden");
        qrImgEl.src = "";
      }
    }

    if (codigoEl) codigoEl.textContent = cert.codigo;
  }

  function getMapping(codigo) {
    if (codigo.startsWith("CBHE-C-")) {
      return {
        table: "capacitacion",
        select: "cursante_nombre, nombre_capacitacion, fecha_emision, codigo, qr_url",
        labels: { primary: "Cursante", secondary: "Capacitación" },
        fieldKeys: { primary: "cursante_nombre", secondary: "nombre_capacitacion" },
      };
    }
    if (codigo.startsWith("CBHE-S-")) {
      return {
        table: "sello",
        select: "empresa_nombre, tipo_certificado, fecha_emision, codigo, qr_url",
        labels: { primary: "Empresa", secondary: "Tipo de Certificado" },
        fieldKeys: { primary: "empresa_nombre", secondary: "tipo_certificado" },
      };
    }
    return null;
  }

  async function verifyCertificate(codigo) {
    if (codeDisplayEl) codeDisplayEl.textContent = codigo;
    showState("loading");

    try {
      if (!supabaseUrl || !supabaseKey) {
        showState("error");
        return;
      }

      const mapping = getMapping(codigo);
      if (!mapping) {
        showState("not-found");
        return;
      }

      const supabase = window.supabase.createClient(supabaseUrl, supabaseKey);
      const { data, error: dbError } = await supabase
        .from(mapping.table)
        .select(mapping.select)
        .eq("codigo", codigo)
        .maybeSingle();

      if (dbError) {
        console.error("Supabase query error:", dbError);
        showState("error");
        return;
      }

      if (!data) {
        showState("not-found");
        return;
      }

      populateCard(data, mapping);
      showState("found");
    } catch (err) {
      console.error("Verification error:", err);
      showState("error");
    }
  }

  const params = new URLSearchParams(window.location.search);
  const codigo = params.get("c")?.trim();

  if (!codigo) {
    showState("not-found");
  } else {
    verifyCertificate(codigo);
  }
</script>
