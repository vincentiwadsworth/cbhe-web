---
import { getCollection } from "astro:content";
import CourseCard from "../components/CourseCard.astro";
import Icon from "../components/Icon.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { parseDateToTimestamp, isPastDate } from "../utils/date";
import { resolveImageUrl } from "../utils/images";

const cursos = await getCollection("cursos", ({ data }) => !data.draft);

// Exclude past courses
const activeCursos = cursos.filter((curso) => !isPastDate(curso.data.startDate));

// Partition into featured and chronological
const featuredCourses = activeCursos.filter((curso) => curso.data.featured);
const chronologicalCourses = activeCursos.filter((curso) => !curso.data.featured);

// Separate chronological courses into "Este mes" (July 2026) and "Próximas"
const esteMesCursos = chronologicalCourses.filter((curso) => {
  const ts = parseDateToTimestamp(curso.data.startDate);
  if (ts === 0) return false;
  const d = new Date(ts);
  return d.getFullYear() === 2026 && d.getMonth() === 6;
});

const proximasCursos = chronologicalCourses.filter((curso) => {
  const ts = parseDateToTimestamp(curso.data.startDate);
  if (ts === 0) return false;
  const d = new Date(ts);
  return d.getFullYear() > 2026 || (d.getFullYear() === 2026 && d.getMonth() > 6);
});

// Sort ascending
esteMesCursos.sort((a, b) => parseDateToTimestamp(a.data.startDate) - parseDateToTimestamp(b.data.startDate));
proximasCursos.sort((a, b) => parseDateToTimestamp(a.data.startDate) - parseDateToTimestamp(b.data.startDate));

const hasFeatured = featuredCourses.length > 0;
const hasEsteMes = esteMesCursos.length > 0;
const hasProximas = proximasCursos.length > 0;

const featuredPy = (hasEsteMes || hasProximas)
  ? "pt-12 sm:pt-16 md:pt-24 pb-6 sm:pb-8 md:pb-12"
  : "py-12 sm:py-16 md:py-24";

const esteMesPy = !hasFeatured
  ? (hasProximas ? "pt-12 sm:pt-16 md:pt-24 pb-6 sm:pb-8 md:pb-12" : "py-12 sm:py-16 md:py-24")
  : (hasProximas ? "py-6 sm:py-8 md:py-12" : "pt-6 sm:pt-8 md:pt-12 pb-12 sm:pb-16 md:pb-24");

const proximasPy = (hasFeatured || hasEsteMes)
  ? "pt-6 sm:pt-8 md:pt-12 pb-12 sm:pb-16 md:pb-24"
  : "py-12 sm:py-16 md:py-24";
---

<PageLayout
  title="Capacitación"
  description="Capacitación y certificación — Desarrollamos el talento del sector energético a través de programas especializados."
  active="capacitacion"
>
  <!-- Hero: unique layout with badge + 2-column, not a SubpageHero -->
  <section class="relative bg-primary pt-20 sm:pt-28 md:pt-32 pb-16 sm:pb-20 md:pb-24 px-4 sm:px-6 md:px-8 overflow-hidden">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-16 items-center">
      <div class="space-y-6 md:space-y-8 z-10 relative">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-on-primary/10 rounded-full">
          <Icon name="material-symbols:school" class="text-primary-fixed size-4" />
          <span class="text-xs font-semibold text-primary-fixed uppercase tracking-wider">
            Formación continua
          </span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-headline font-bold text-on-primary leading-tight tracking-tight">
          Capacitación y certificación
        </h1>
        <p class="text-base sm:text-lg md:text-xl text-on-primary/90 leading-relaxed max-w-xl">
          Desarrollamos el talento del sector energético a través de programas especializados
          y certificaciones con los más altos estándares de la industria.
        </p>
        <div class="flex flex-wrap gap-4 pt-4">
          <a
            href={`${import.meta.env.BASE_URL}/capacitacion/#catalogo`}
            class="bg-on-primary text-primary px-8 py-4 rounded-md font-semibold hover:bg-primary-fixed hover:shadow-md transition-all min-h-[44px] inline-flex items-center gap-2 spring-press"
          >
            Explorar capacitaciones
            <Icon name="material-symbols:arrow-downward" class="size-4" />
          </a>
          <a
            href="https://wa.me/59179891193"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-on-primary/10 text-on-primary px-8 py-4 rounded-md font-semibold hover:bg-on-primary/20 transition-all min-h-[44px] inline-flex items-center gap-2"
          >
            <Icon name="material-symbols:chat" class="size-5" />
            Más información
          </a>
        </div>
      </div>

      <!-- Image + stats card -->
      <div class="relative z-10 hidden lg:block">
        <div class="aspect-4/3 rounded-xl overflow-hidden shadow-2xl relative">
          {[
            { src: resolveImageUrl("/images/capacitacion/hero-equipo-diverso.webp"), alt: "Equipo diverso colaborando — capacitación CBHE" },
            { src: resolveImageUrl("/images/capacitacion/hero-oficina-meeting.webp"), alt: "Capacitación en oficina — formación profesional CBHE" },
          ].map((img, i) => (
            <img
              src={img.src}
              alt={img.alt}
              class="absolute inset-0 w-full h-full object-cover fade-slide"
              style={`animation-delay: ${i * 5}s`}
              loading={i === 0 ? "eager" : "lazy"}
            />
          ))}
          <div class="absolute inset-0 bg-gradient-to-t from-primary/70 via-primary/30 to-primary/10"></div>
        </div>
        <div class="absolute -bottom-8 -left-8 bg-surface p-6 rounded-lg shadow-xl border border-outline-variant/30 flex gap-8">
          <div>
            <div class="text-3xl font-bold text-primary">1.233</div>
            <div class="text-xs text-on-surface-variant font-medium mt-1 uppercase tracking-wider">Cursos desde 2014</div>
          </div>
          <div class="w-px bg-outline-variant/30"></div>
          <div>
            <div class="text-3xl font-bold text-primary">15.275</div>
            <div class="text-xs text-on-surface-variant font-medium mt-1 uppercase tracking-wider">PROFESIONALES CAPACITADOS</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Formación con respaldo internacional -->
  <Section bg="surface-container-low">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Text -->
      <div class="space-y-6 lg:pr-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-primary-container/10 rounded-full">
          <Icon name="material-symbols:verified" class="text-primary size-4" />
          <span class="text-xs font-semibold text-primary uppercase tracking-wider">
            Respaldo internacional
          </span>
        </div>
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-headline font-bold text-on-surface leading-tight">
          Formación certificada por entidades de clase mundial
        </h2>
        <p class="text-base md:text-lg text-on-surface-variant leading-relaxed max-w-lg">
          Las instalaciones de la CBHE están diseñadas para impartir programas de capacitación
          que cumplen con los requisitos de las certificadoras más exigentes del sector energético.
        </p>
        <p class="text-base text-on-surface-variant leading-relaxed max-w-lg">
          Nuestros programas cuentan con el respaldo de entidades como NFPA, EnginZone, ASTM, AWS,
          NSC y FPI, referentes internacionales en seguridad contra incendios, soldadura, estándares
          técnicos y protección de activos industriales.
        </p>
      </div>

      <!-- Carousel -->
      <div class="relative aspect-[16/9] rounded-lg overflow-hidden bg-surface-container-low shadow-sm">
        {[
          { src: resolveImageUrl("/images/capacitacion/carousel-1.webp"), alt: "Capacitación técnica CBHE — sesión de formación" },
          { src: resolveImageUrl("/images/capacitacion/carousel-2.webp"), alt: "Capacitación técnica CBHE — trabajo en equipo" },
          { src: resolveImageUrl("/images/capacitacion/carousel-3.webp"), alt: "Capacitación técnica CBHE — sesión práctica" },
        ].map((img, i) => (
          <img
            src={img.src}
            alt={img.alt}
            class="absolute inset-0 w-full h-full object-cover fade-slide"
            style={`animation-delay: ${i * 5}s`}
            loading={i === 0 ? "eager" : "lazy"}
          />
        ))}
      </div>
    </div>
  </Section>

  <!-- Certification logos — Infinite Marquee Ribbon (white bg) -->
  <section class="bg-white py-12 md:py-16 reveal">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8">
      <style>
        .cert-marquee {
          position: relative;
          overflow: hidden;
          -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
          mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
        }
        .cert-track {
          display: flex;
          gap: 1.25rem;
          width: max-content;
          animation: cert-scroll 28s linear infinite;
          will-change: transform;
        }
        @media (min-width: 640px) { .cert-track { gap: 1.75rem; animation-duration: 34s; } }
        @media (min-width: 1024px) { .cert-track { gap: 2.25rem; animation-duration: 40s; } }
        .cert-marquee:hover .cert-track { animation-play-state: paused; }

        .cert-logo {
          display: flex;
          align-items: center;
          justify-content: center;
          flex-shrink: 0;
          padding: 0.75rem 1.25rem;
          border-radius: 0.75rem;
          border: 1px solid transparent;
          background: white;
          transition: border-color 0.25s ease, box-shadow 0.25s ease;
          animation: cert-wave 3.2s ease-in-out infinite;
        }
        .cert-logo:nth-child(1)  { animation-delay: 0.00s; }
        .cert-logo:nth-child(2)  { animation-delay: 0.20s; }
        .cert-logo:nth-child(3)  { animation-delay: 0.40s; }
        .cert-logo:nth-child(4)  { animation-delay: 0.60s; }
        .cert-logo:nth-child(5)  { animation-delay: 0.80s; }
        .cert-logo:nth-child(6)  { animation-delay: 1.00s; }
        .cert-logo:nth-child(7)  { animation-delay: 1.20s; }
        .cert-logo:nth-child(8)  { animation-delay: 1.40s; }
        .cert-logo:nth-child(9)  { animation-delay: 1.60s; }
        .cert-logo:nth-child(10) { animation-delay: 1.80s; }

        .cert-logo:hover {
          border-color: var(--color-primary);
          box-shadow: 0 4px 16px rgba(1, 64, 108, 0.1);
        }
        .cert-logo img {
          height: 2.5rem;
          width: auto;
          max-width: 140px;
          object-fit: contain;
          filter: grayscale(1);
          transition: filter 0.3s ease;
        }
        .cert-logo:hover img { filter: grayscale(0); }
        @media (min-width: 768px) {
          .cert-logo { padding: 1rem 1.5rem; }
          .cert-logo img { height: 3rem; max-width: 170px; }
        }

        @keyframes cert-scroll {
          0%   { transform: translateX(0); }
          100% { transform: translateX(-50%); }
        }
        @keyframes cert-wave {
          0%, 100% { transform: translateY(0); }
          50%       { transform: translateY(-5px); }
        }
        @media (prefers-reduced-motion: reduce) {
          .cert-track, .cert-logo { animation: none !important; }
        }
      </style>

      <p class="text-center text-xs font-semibold text-on-surface-variant uppercase tracking-widest mb-8">
        Avaladas por
      </p>

      <div class="cert-marquee">
        <div class="cert-track">
          <div class="cert-logo"><img src={resolveImageUrl("/images/capacitacion/Logos/NFPA%20AUTORIZED.svg")} alt="NFPA — Authorized Training Provider" loading="lazy" /></div>
          <div class="cert-logo"><img src={resolveImageUrl("/images/capacitacion/Logos/Logo%20Enginzone.svg")} alt="EnginZone — Capacitación técnica" loading="lazy" /></div>
          <div class="cert-logo"><img src={resolveImageUrl("/images/capacitacion/Logos/Logo%20ASTM.svg")} alt="ASTM International" loading="lazy" /></div>
          <div class="cert-logo"><img src={resolveImageUrl("/images/capacitacion/Logos/Logo%20AWS.svg")} alt="AWS — American Welding Society" loading="lazy" /></div>
          <div class="cert-logo"><img src={resolveImageUrl("/images/capacitacion/Logos/Logo%20FPI.svg")} alt="FPI — Fire Protection Institute" loading="lazy" /></div>
          <!-- Set B (duplicated for seamless loop) -->
          <div class="cert-logo" aria-hidden="true"><img src={resolveImageUrl("/images/capacitacion/Logos/NFPA%20AUTORIZED.svg")} alt="" loading="lazy" /></div>
          <div class="cert-logo" aria-hidden="true"><img src={resolveImageUrl("/images/capacitacion/Logos/Logo%20Enginzone.svg")} alt="" loading="lazy" /></div>
          <div class="cert-logo" aria-hidden="true"><img src={resolveImageUrl("/images/capacitacion/Logos/Logo%20ASTM.svg")} alt="" loading="lazy" /></div>
          <div class="cert-logo" aria-hidden="true"><img src={resolveImageUrl("/images/capacitacion/Logos/Logo%20AWS.svg")} alt="" loading="lazy" /></div>
          <div class="cert-logo" aria-hidden="true"><img src={resolveImageUrl("/images/capacitacion/Logos/Logo%20FPI.svg")} alt="" loading="lazy" /></div>
        </div>
      </div>
    </div>
  </section>

  <style>
    @keyframes slideFade {
      0%, 42% { opacity: 1; }
      50%, 92% { opacity: 0; }
      100% { opacity: 1; }
    }
    .fade-slide {
      opacity: 0;
      animation: slideFade 10s infinite;
    }
    .fade-slide:nth-child(1) { animation-delay: 0s; }
    .fade-slide:nth-child(2) { animation-delay: 5s; }
    @media (prefers-reduced-motion: reduce) {
      .fade-slide {
        animation: none;
        opacity: 1;
        position: static;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .fade-slide ~ .fade-slide {
        position: absolute;
        clip: rect(0, 0, 0, 0);
      }
    }
  </style>

  <!-- Course Grid -->
  <div id="catalogo" class="scroll-mt-24">
    <!-- Cursos destacados -->
    {hasFeatured && (
      <Section bg="surface" py={featuredPy}>
        <SectionHeading title="Cursos destacados" description="Programas recomendados y de alta especialización." />
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {featuredCourses.map((curso) => (
            <CourseCard curso={curso} variant="default" />
          ))}
        </div>
      </Section>
    )}

    <!-- Este mes -->
    {hasEsteMes && (
      <Section bg="surface" py={esteMesPy}>
        <SectionHeading title="Este mes" description="Capacitaciones que inician durante este mes." />
        <div data-load-more="3" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {esteMesCursos.map((curso) => (
            <div data-load-more-item>
              <CourseCard curso={curso} variant="default" />
            </div>
          ))}
        </div>
        <div data-load-more-wrapper class="mt-12 text-center">
          <button data-load-more-btn class="bg-surface border border-outline-variant px-8 py-3 rounded-md font-medium text-on-surface hover:bg-surface-container-low hover:border-primary/30 transition-all min-h-[44px] inline-flex items-center gap-2">
            <span data-load-more-text>Cargar más</span>
            <Icon name="material-symbols:refresh" class="size-5" />
          </button>
        </div>
      </Section>
    )}

    <!-- Próximas capacitaciones -->
    {hasProximas && (
      <Section bg="surface" py={proximasPy}>
        <SectionHeading title="Próximas capacitaciones" description="Planifique su desarrollo profesional con nuestros próximos cursos." />
        <div data-load-more="3" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {proximasCursos.map((curso) => (
            <div data-load-more-item>
              <CourseCard curso={curso} variant="default" />
            </div>
          ))}
        </div>
        <div data-load-more-wrapper class="mt-12 text-center">
          <button data-load-more-btn class="bg-surface border border-outline-variant px-8 py-3 rounded-md font-medium text-on-surface hover:bg-surface-container-low hover:border-primary/30 transition-all min-h-[44px] inline-flex items-center gap-2">
            <span data-load-more-text>Cargar más</span>
            <Icon name="material-symbols:refresh" class="size-5" />
          </button>
        </div>
      </Section>
    )}
  </div>

  <!-- CTA: Inscríbase ahora -->
  <section class="bg-inverse-surface py-16 sm:py-20 md:py-28 px-4 sm:px-6 md:px-8">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div class="space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-inverse-on-surface/10 rounded-full">
            <Icon name="material-symbols:qr-code-2" class="text-primary-fixed size-4" />
            <span class="text-xs font-semibold text-primary-fixed uppercase tracking-wider">
              Inscríbase ahora
            </span>
          </div>
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-headline font-bold text-inverse-on-surface leading-tight">
            Inscríbase ahora
          </h2>
          <p class="text-inverse-on-surface/80 leading-relaxed max-w-lg text-base md:text-lg">
            Escanee el código QR con su dispositivo móvil para acceder directamente al formulario de inscripción y a la información de contacto del área de Capacitación de la CBHE.
          </p>
          <div class="flex flex-wrap gap-4 pt-2">
            <a
              href="https://wa.me/59179891193"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-primary-fixed text-primary px-7 py-3.5 rounded-md font-semibold hover:bg-primary-fixed/90 transition-all min-h-[44px] inline-flex items-center gap-2 text-sm spring-press"
            >
              <Icon name="material-symbols:chat" class="size-5" />
              Reserve su lugar
            </a>
            <a
              href="mailto:capacitacion@cbhe.org.bo"
              class="border border-inverse-on-surface/30 text-inverse-on-surface px-7 py-3.5 rounded-md font-semibold hover:bg-inverse-on-surface/10 transition-all min-h-[44px] inline-flex items-center gap-2 text-sm"
            >
              <Icon name="material-symbols:mail" class="size-5" />
              Consultar por email
            </a>
          </div>
        </div>
        <div class="flex justify-center lg:justify-end">
          <div class="bg-inverse-on-surface/10 backdrop-blur-sm p-6 sm:p-8 rounded-xl border border-inverse-on-surface/15 text-center">
            <img
              src={resolveImageUrl("/images/qr-capacitacion.png")}
              alt="Código QR de Capacitación CBHE"
              class="w-44 h-44 sm:w-48 sm:h-48 rounded-lg mb-4 mx-auto"
              loading="lazy"
            />
            <p class="text-sm text-inverse-on-surface/80 font-medium">Código QR oficial de Capacitación CBHE</p>
            <p class="text-xs text-inverse-on-surface/50 mt-1">Escanee con su dispositivo móvil</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { initLoadMore } from "../scripts/load-more";
    initLoadMore();
  </script>
</PageLayout>