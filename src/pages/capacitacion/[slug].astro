---
import { getCollection, render } from "astro:content";
import Icon from "../../components/Icon.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import CourseInstructor from "../../components/CourseInstructor.astro";
import CourseCTA from "../../components/CourseCTA.astro";
import RelatedCourses from "../../components/RelatedCourses.astro";
import { resolveImageUrl } from "../../utils/images";

export async function getStaticPaths() {
  const cursos = await getCollection("cursos", ({ data }) => !data.draft);
  return cursos.map((c) => ({ params: { slug: c.id } }));
}

const { slug } = Astro.params;
const allCursos = await getCollection("cursos", ({ data }) => !data.draft);
const curso = allCursos.find((c) => c.id === slug);

if (!curso) return Astro.redirect("/404");

const { Content } = await render(curso);

const hasInstructors =
  curso.data.instructors && curso.data.instructors.length > 0;
const hasBody = Boolean(curso.body && curso.body.trim());
---

<PageLayout
  title={curso.data.title}
  description={curso.data.description || `Curso de ${curso.data.category}: ${curso.data.title}`}
  image={curso.data.image}
  currentPath={`capacitacion/${slug}`}
  active="capacitacion"
  mainClass="max-w-4xl mx-auto px-4 sm:px-6 md:px-8 py-0 sm:py-0 md:py-0"
>
  <!-- ================================================================== -->
  <!--  1. Outcome Hero                                                     -->
  <!-- ================================================================== -->
  <section
    aria-labelledby="course-title"
    class="pt-12 sm:pt-16 md:pt-24 pb-8 sm:pb-10"
  >
    <!-- Breadcrumb -->
    <nav class="mb-8 text-sm text-on-surface-variant" aria-label="Navegación">
      <a
        href=""
        class="hover:text-primary hover:underline hover:underline-offset-4 transition-colors"
      >Inicio</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <a
        href="capacitacion"
        class="hover:text-primary hover:underline hover:underline-offset-4 transition-colors"
      >Capacitación</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span class="text-on-surface">{curso.data.title}</span>
    </nav>

    <!-- Hero image or icon fallback -->
    {
      curso.data.image ? (
        <figure class="mb-10 rounded-xl overflow-hidden">
          <img
            src={resolveImageUrl(curso.data.image)}
            alt={curso.data.title}
            class="w-full h-auto object-cover rounded-xl"
            loading="eager"
          />
        </figure>
      ) : (
        <div class="mb-10 rounded-xl overflow-hidden bg-primary-container aspect-video flex items-center justify-center">
          <Icon
            name="material-symbols:school"
            class="size-24 text-primary opacity-30"
          />
        </div>
      )
    }

    <!-- Category + Modality badges -->
    <div class="flex flex-wrap items-center gap-3 mb-6">
      <span
        class={`inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider px-3 py-1 rounded-full ${curso.data.category === "Certificación"
            ? "bg-tertiary-container text-on-tertiary-container"
            : "bg-primary-container text-on-primary-container"
          }`}
      >
        <Icon
          name={`material-symbols:${curso.data.category === "Certificación" ? "verified" : "school"}`}
          class="size-3.5"
        />
        {curso.data.category}
      </span>
      <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-on-surface-variant bg-surface-container-high px-3 py-1 rounded-full">
        {curso.data.modality === "Virtual" && (
          <Icon name="material-symbols:desktop-windows" class="size-3.5" />
        )}
        {curso.data.modality === "Presencial" && (
          <Icon name="material-symbols:apartment" class="size-3.5" />
        )}
        {curso.data.modality === "Híbrido" && (
          <Icon name="material-symbols:devices" class="size-3.5" />
        )}
        {curso.data.modality}
      </span>
    </div>

    <!-- Title (h1) -->
    <h1
      id="course-title"
      class="text-3xl sm:text-4xl md:text-5xl font-headline font-bold text-on-surface leading-tight tracking-tight mb-4"
    >
      {curso.data.title}
    </h1>

    <!-- Outcome-focused subtitle -->
    {
      curso.data.description && (
        <p class="text-base sm:text-lg text-on-surface-variant leading-relaxed max-w-2xl">
          {curso.data.description}
        </p>
      )
    }

    <!-- CTA sentinel for CourseCTA IntersectionObserver -->
    <div id="cta-sentinel" aria-hidden="true"></div>
  </section>

  <!-- ================================================================== -->
  <!--  2. Quick Facts Bar                                                  -->
  <!-- ================================================================== -->
  <section
    aria-labelledby="quick-facts-heading"
    class="pb-10 sm:pb-16 border-b border-outline-variant/20"
  >
    <h2 id="quick-facts-heading" class="sr-only">Datos del curso</h2>

    <div
      class="flex overflow-x-auto gap-3 pb-1 snap-x snap-mandatory scrollbar-none
                 sm:flex-wrap sm:overflow-visible sm:snap-none sm:gap-4"
    >
      <!-- Date -->
      <div
        class="bg-surface-container-low rounded-lg p-4 flex items-start gap-3 shrink-0 snap-start min-w-[160px] sm:min-w-0 sm:flex-1"
      >
        <Icon
          name="material-symbols:calendar-today"
          class="size-5 text-primary shrink-0 mt-0.5"
        />
        <div>
          <p class="text-xs font-semibold text-on-surface uppercase tracking-wider mb-0.5">
            Fecha de inicio
          </p>
          <p class="text-sm text-on-surface-variant">{curso.data.startDate}</p>
        </div>
      </div>

      <!-- Price -->
      {curso.data.price && (
        <div
          class="bg-surface-container-low rounded-lg p-4 flex items-start gap-3 shrink-0 snap-start min-w-[160px] sm:min-w-0 sm:flex-1"
        >
          <Icon
            name="material-symbols:payments"
            class="size-5 text-primary shrink-0 mt-0.5"
          />
          <div>
            <p class="text-xs font-semibold text-on-surface uppercase tracking-wider mb-0.5">
              Inversión
            </p>
            <p class="text-sm text-on-surface-variant">
              {curso.data.price}
            </p>
          </div>
        </div>
      )}

      <!-- Modality -->
      <div
        class="bg-surface-container-low rounded-lg p-4 flex items-start gap-3 shrink-0 snap-start min-w-[160px] sm:min-w-0 sm:flex-1"
      >
        {curso.data.modality === "Virtual" && (
          <Icon
            name="material-symbols:desktop-windows"
            class="size-5 text-primary shrink-0 mt-0.5"
          />
        )}
        {curso.data.modality === "Presencial" && (
          <Icon
            name="material-symbols:apartment"
            class="size-5 text-primary shrink-0 mt-0.5"
          />
        )}
        {curso.data.modality === "Híbrido" && (
          <Icon
            name="material-symbols:devices"
            class="size-5 text-primary shrink-0 mt-0.5"
          />
        )}
        <div>
          <p class="text-xs font-semibold text-on-surface uppercase tracking-wider mb-0.5">
            Modalidad
          </p>
          <p class="text-sm text-on-surface-variant">{curso.data.modality}</p>
        </div>
      </div>

      <!-- Registration Deadline -->
      {curso.data.registrationDeadline && (
        <div
          class="bg-surface-container-low rounded-lg p-4 flex items-start gap-3 shrink-0 snap-start min-w-[160px] sm:min-w-0 sm:flex-1"
        >
          <Icon
            name="material-symbols:schedule"
            class="size-5 text-primary shrink-0 mt-0.5"
          />
          <div>
            <p class="text-xs font-semibold text-on-surface uppercase tracking-wider mb-0.5">
              Inscripción hasta
            </p>
            <p class="text-sm text-on-surface-variant">
              {curso.data.registrationDeadline}
            </p>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ================================================================== -->
  <!--  3. Course body — staff-authored markdown, rendered once             -->
  <!-- ================================================================== -->
  {
    hasBody && (
      <section class="py-10 sm:py-16 border-b border-outline-variant/20">
        <article
          class="prose prose-lg max-w-none
            prose-headings:font-headline prose-headings:text-on-surface prose-headings:font-bold
            prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4
            prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
            prose-p:text-on-surface-variant prose-p:leading-relaxed prose-p:mb-5
            prose-a:text-primary prose-a:no-underline hover:prose-a:underline
            prose-strong:text-on-surface prose-strong:font-semibold
            prose-ul:text-on-surface-variant prose-li:marker:text-primary
          "
        >
          <Content />
        </article>
      </section>
    )
  }

  <!-- ================================================================== -->
  <!--  6. Instructor Credibility                                           -->
  <!-- ================================================================== -->
  {
    hasInstructors && (
      <section
        aria-labelledby="instructors-heading"
        class="py-10 sm:py-16 border-b border-outline-variant/20"
      >
        <h2
          id="instructors-heading"
          class="text-xl sm:text-2xl font-headline font-bold text-on-surface mb-6 flex items-center gap-2.5"
        >
          <Icon
            name="material-symbols:person"
            class="size-6 text-primary shrink-0"
          />
          Instructor{curso.data.instructors.length > 1 ? "es" : ""}
        </h2>
        <CourseInstructor instructors={curso.data.instructors} />
      </section>
    )
  }

  <!-- ================================================================== -->
  <!--  7. Social Proof — stats + endorsements                               -->
  <!-- ================================================================== -->
  <section
    aria-labelledby="social-proof-heading"
    class="py-10 sm:py-16 border-b border-outline-variant/20"
  >
    <h2
      id="social-proof-heading"
      class="text-xl sm:text-2xl font-headline font-bold text-on-surface mb-6 flex items-center gap-2.5"
    >
      <Icon
        name="material-symbols:verified"
        class="size-6 text-primary shrink-0"
      />
      Respaldo institucional
    </h2>

    <!-- Stats row -->
    <div class="grid grid-cols-2 gap-4 mb-8">
      <div class="bg-surface-container-low rounded-lg p-6 text-center">
        <div class="text-3xl font-bold text-primary">1.233</div>
        <p class="text-xs text-on-surface-variant font-medium mt-2 uppercase tracking-wider">
          Cursos desde 2014
        </p>
      </div>
      <div class="bg-surface-container-low rounded-lg p-6 text-center">
        <div class="text-3xl font-bold text-primary">15.275</div>
        <p class="text-xs text-on-surface-variant font-medium mt-2 uppercase tracking-wider">
          Profesionales capacitados
        </p>
      </div>
    </div>

    <!-- Endorsement badges -->
    <div class="bg-surface-container-low rounded-lg p-6">
      <p class="text-xs font-semibold text-outline uppercase tracking-widest mb-4 text-center">
        Avaladas por
      </p>
      <div class="flex flex-wrap items-center justify-center gap-6">
        <div class="flex items-center gap-2 text-on-surface-variant">
          <Icon
            name="material-symbols:local-fire-department"
            class="size-5 text-tertiary shrink-0"
          />
          <span class="text-sm font-semibold">NFPA</span>
        </div>
        <span class="text-outline-variant hidden sm:inline" aria-hidden="true">|</span>
        <div class="flex items-center gap-2 text-on-surface-variant">
          <Icon
            name="material-symbols:security"
            class="size-5 text-tertiary shrink-0"
          />
          <span class="text-sm font-semibold">UL / FM Approvals</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ================================================================== -->
  <!--  10. Final CTA — enrollment + back link                               -->
  <!-- ================================================================== -->
  <section
    aria-labelledby="final-cta-heading"
    class="py-10 sm:py-16"
  >
    <div class="bg-primary-container/10 rounded-xl p-8 text-center">
      <h2
        id="final-cta-heading"
        class="text-2xl font-headline font-bold text-on-surface mb-3"
      >
        ¿Listo para inscribirte?
      </h2>
      <p class="text-on-surface-variant mb-6 max-w-lg mx-auto">
        Contactanos por WhatsApp para más información sobre inscripciones,
        descuentos corporativos y formas de pago.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        {/* WhatsApp — primary */}
        <a
          href="https://wa.me/59179891193"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-primary text-on-primary px-8 py-4 rounded-md font-semibold hover:bg-primary/90 hover:shadow-md transition-all min-h-[44px] spring-press"
        >
          <Icon name="material-symbols:chat" class="size-5" />
          Consultar por WhatsApp
        </a>

        {/* Canva link — secondary */}
        {curso.data.canvaLink && (
          <a
            href={curso.data.canvaLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-surface-container-high text-primary px-8 py-4 rounded-md font-semibold hover:bg-surface-container hover:border-primary/30 border border-outline-variant/20 transition-all min-h-[44px]"
          >
            <Icon name="material-symbols:palette" class="size-5" />
            Ver en Canva
          </a>
        )}

        {/* Email — secondary */}
        <a
          href="mailto:capacitacion@cbhe.org.bo"
          class="inline-flex items-center justify-center gap-2 bg-surface-container-high text-primary px-8 py-4 rounded-md font-semibold hover:bg-surface-container hover:border-primary/30 border border-outline-variant/20 transition-all min-h-[44px]"
        >
          <Icon name="material-symbols:mail" class="size-5" />
          Enviar correo
        </a>
      </div>
    </div>

    <!-- Back link -->
    <div class="mt-10 pt-8 border-t border-outline-variant/30">
      <a
        href="capacitacion"
        class="inline-flex items-center gap-2 text-primary font-medium hover:underline hover:underline-offset-4 min-h-[44px]"
      >
        <Icon
          name="material-symbols:arrow-forward"
          class="size-4 rotate-180"
        />
        Volver a capacitación
      </a>
    </div>
  </section>

  <!-- ================================================================== -->
  <!--  11. Related Courses                                                  -->
  <!-- ================================================================== -->
  <RelatedCourses
    currentSlug={slug}
    category={curso.data.category}
    allCourses={allCursos}
    className="py-10 sm:py-16 border-t border-outline-variant/20"
  />

  <!-- ================================================================== -->
  <!--  Sticky CTA (mobile) — at end of DOM, position: fixed                -->
  <!-- ================================================================== -->
  <CourseCTA canvaLink={curso.data.canvaLink} />
</PageLayout>

<!-- ================================================================== -->
<!--  Component-scoped styles — detail page overrides                      -->
<!-- ================================================================== -->
<style>
  /* Hide scrollbar on Quick Facts bar (mobile) while keeping functionality */
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
</style>
