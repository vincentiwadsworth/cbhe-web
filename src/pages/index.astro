---
import { getCollection } from "astro:content";
import Icon from "../components/Icon.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Web3Form from "../components/Web3Form.astro";
import FormInput from "../components/FormInput.astro";
import PageLayout from "../layouts/PageLayout.astro";
import PreciosGrid from "../components/PreciosGrid.astro";
import TestimonialCarousel from "../components/TestimonialCarousel.astro";
import preciosData from "../../data/prices.json";
import { parseDateToTimestamp } from "../utils/date";
import { resolveImageUrl } from "../utils/images";

const articulos = await getCollection("articulos", ({ data }) => !data.draft);
const cursos = await getCollection("cursos", ({ data }) => !data.draft);
const empresas = await getCollection("empresas");
const testimonios = await getCollection("testimonios", ({ data }) => !data.draft);

const parseFecha = (d: string) => parseDateToTimestamp(d);

const articulosPorFecha = (a: any, b: any) => parseFecha(b.data.date) - parseFecha(a.data.date);
const cursosPorFecha = (a: any, b: any) => parseFecha(b.data.startDate) - parseFecha(a.data.startDate);

const ultimosArticulos = articulos.sort(articulosPorFecha).slice(0, 3);
const cursosDestacados = cursos.sort(cursosPorFecha).slice(0, 2);

const modeIcons: Record<string, string> = {
  Virtual: "desktop-windows",
  Presencial: "apartment",
  Híbrido: "devices",
};

const groupSlugs: Record<string, string> = {
  "Exploración y producción": "upstream",
  "Servicios en pozo": "pozo",
  "Servicios en superficie": "superficie",
  "Industria y transporte": "downstream",
  "Servicios auxiliares": "auxiliares",
};

const countByGroup: Record<string, number> = {
  upstream: empresas.filter((e) => e.data.grupo === "upstream").length,
  pozo: empresas.filter((e) => e.data.grupo === "pozo").length,
  superficie: empresas.filter((e) => e.data.grupo === "superficie").length,
  downstream: empresas.filter((e) => e.data.grupo === "downstream").length,
  auxiliares: empresas.filter((e) => e.data.grupo === "auxiliares").length,
};

const gruposHome = [
  { title: "Exploración y producción", desc: "Búsqueda y extracción de hidrocarburos con tecnología de vanguardia.", count: countByGroup.upstream },
  { title: "Servicios en pozo", desc: "Perforación, terminación, cementación y mantenimiento de pozos.", count: countByGroup.pozo },
  { title: "Servicios en superficie", desc: "Ingeniería, construcción y operación de facilidades de producción.", count: countByGroup.superficie },
  { title: "Industria y transporte", desc: "Refinación, ductos, distribución y comercialización de hidrocarburos y energía.", count: countByGroup.downstream },
  { title: "Servicios auxiliares", desc: "Consultoría legal, técnica, ambiental, seguros y logística.", count: countByGroup.auxiliares },
];
---

<PageLayout title="Inicio" description="Cámara Boliviana de Hidrocarburos y Energía — Integramos energías con liderazgo e innovación." active="inicio">
  <!-- Homepage Hero (unique — not a SubpageHero) -->
  <!-- CSS-only crossfade carousel: 3 images stacked in Grid, GPU-composited opacity keyframes -->
  <header
    class="relative min-h-[85dvh] sm:min-h-[550px] md:min-h-[600px] flex items-center sm:items-end bg-surface-container-low overflow-hidden"
    role="region"
    aria-label="Galería decorativa del sector hidrocarburífero"
  >
    <div class="absolute inset-0 z-0 grid grid-cols-1 grid-rows-1">
      <img
        alt="Vista aérea de gasoducto cruzando el paisaje boliviano entre el Chaco y la Amazonía al atardecer"
        class="hero-img w-full h-full object-cover"
        data-hero-image
        fetchpriority="high"
        height="800"
        src="images/hero/hero-gasoducto.webp"
        width="1200"
      />
      <img
        alt="Antorcha de gas natural iluminando el cielo nocturno en un campo de explotación boliviano"
        class="hero-img w-full h-full object-cover"
        height="800"
        loading="lazy"
        src="images/hero/hero-gas-flare.webp"
        width="1200"
      />
      <img
        alt="Llama azul de hornalla de gas natural representando la energía boliviana sobre fondo oscuro"
        class="hero-img w-full h-full object-cover"
        height="800"
        loading="lazy"
        src="images/hero/hero-blue-flame.webp"
        width="1200"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-black/50 to-black/85"></div>
    </div>

    <!-- Decorative dot indicators — CSS-only, aria-hidden, not interactive -->
    <div class="absolute bottom-6 left-0 right-0 z-10 flex justify-center gap-2 pointer-events-none" aria-hidden="true">
      <span class="hero-dot size-2.5 rounded-full bg-inverse-on-surface/60"></span>
      <span class="hero-dot size-2.5 rounded-full bg-inverse-on-surface/60"></span>
      <span class="hero-dot size-2.5 rounded-full bg-inverse-on-surface/60"></span>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 md:px-8 w-full pb-16 sm:pb-18 md:pb-20 text-center">
      <h1 class="text-inverse-on-surface font-headline font-extrabold text-3xl sm:text-4xl md:text-5xl lg:text-6xl leading-snug mb-5 md:mb-6 tracking-tight max-w-4xl mx-auto">
        <span class="block">Representamos a quienes producen</span>
        <span class="block"><span class="text-primary-fixed text-4xl sm:text-5xl md:text-6xl lg:text-7xl">el 99%</span></span>
        <span class="block">del gas natural boliviano</span>
      </h1>
      <p class="text-inverse-on-surface/80 font-body text-base sm:text-lg md:text-xl mb-8 sm:mb-10 md:mb-12 max-w-2xl mx-auto leading-relaxed sm:leading-loose">
        Integramos energías con liderazgo e innovación desde 1986.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
        <a href="quienes-somos" class="bg-inverse-on-surface text-inverse-surface rounded-md px-6 sm:px-8 py-3.5 sm:py-4 font-semibold hover:bg-surface-bright hover:shadow-md transition-all min-h-[44px] spring-press">
          Conózcanos
        </a>
        <a href="novedades" class="border-2 border-white/50 bg-white/5 text-inverse-on-surface rounded-md px-6 sm:px-8 py-3.5 sm:py-4 font-semibold hover:bg-inverse-on-surface/10 transition-all min-h-[44px] spring-press">
          Novedades
        </a>
      </div>
    </div>
  </header>

  <style>
    /*
     * Hero Carousel — CSS-only crossfade.
     * Zero JS. GPU-composited (opacity only).
     *
     * 3 separate keyframes, one per image, so the loop boundary
     * (last→first transition) is a TRUE crossfade, not a hard cut.
     *
     * Timing: 19.5s cycle = 3 × 6.5s per image (5s visible + 1.5s crossfade).
     * Order: gasoducto → blue-flame → gas-flare → (loop to gasoducto)
     */

    /* --- Images --- */
    .hero-img { grid-area: 1 / 1; }

    .hero-img:nth-child(1) { animation: hero-img-1 19.5s infinite; }
    .hero-img:nth-child(2) { animation: hero-img-2 19.5s infinite; }
    .hero-img:nth-child(3) { animation: hero-img-3 19.5s infinite; }

    /* Image 1 (gasoducto): visible [0s-5s], fade to Img3 [5s-6.5s],
       fade in from Img2 [18s-19.5s] — wraps smoothly at 100%→0% */
    @keyframes hero-img-1 {
      0%       { opacity: 1; }
      25.64%   { opacity: 1; }
      33.33%   { opacity: 0; }
      92.31%   { opacity: 0; }
      100%     { opacity: 1; }
    }

    /* Image 3 (blue-flame): fade in from Img1 [5s-6.5s],
       visible [6.5s-11.5s], fade to Img2 [11.5s-13s] */
    @keyframes hero-img-3 {
      0%       { opacity: 0; }
      25.64%   { opacity: 0; }
      33.33%   { opacity: 1; }
      59.0%    { opacity: 1; }
      66.67%   { opacity: 0; }
      100%     { opacity: 0; }
    }

    /* Image 2 (gas-flare): fade in from Img3 [11.5s-13s],
       visible [13s-18s], fade to Img1 [18s-19.5s] */
    @keyframes hero-img-2 {
      0%       { opacity: 0; }
      59.0%    { opacity: 0; }
      66.67%   { opacity: 1; }
      92.31%   { opacity: 1; }
      100%     { opacity: 0; }
    }

    /* --- Decorative Dots — same timing per position --- */
    .hero-dot:nth-child(1) { animation: hero-dot-1 19.5s infinite; }
    .hero-dot:nth-child(2) { animation: hero-dot-2 19.5s infinite; }
    .hero-dot:nth-child(3) { animation: hero-dot-3 19.5s infinite; }

    @keyframes hero-dot-1 {
      0%       { opacity: 1; }
      25.64%   { opacity: 1; }
      33.33%   { opacity: 0.3; }
      92.31%   { opacity: 0.3; }
      100%     { opacity: 1; }
    }
    @keyframes hero-dot-3 {
      0%       { opacity: 0.3; }
      25.64%   { opacity: 0.3; }
      33.33%   { opacity: 1; }
      59.0%    { opacity: 1; }
      66.67%   { opacity: 0.3; }
      100%     { opacity: 0.3; }
    }
    @keyframes hero-dot-2 {
      0%       { opacity: 0.3; }
      59.0%    { opacity: 0.3; }
      66.67%   { opacity: 1; }
      92.31%   { opacity: 1; }
      100%     { opacity: 0.3; }
    }

    /* --- Reduced Motion: show first image only --- */
    @media (prefers-reduced-motion: reduce) {
      .hero-img:nth-child(1) { animation: none; opacity: 1; }
      .hero-img:nth-child(2) { animation: none; opacity: 0; }
      .hero-img:nth-child(3) { animation: none; opacity: 0; }
      .hero-dot:nth-child(1) { animation: none; opacity: 1; }
      .hero-dot:nth-child(2) { animation: none; opacity: 0.3; }
      .hero-dot:nth-child(3) { animation: none; opacity: 0.3; }
    }
  </style>

  <!-- Datos del Sector -->
  <PreciosGrid data={preciosData} />

  <!-- Quiénes Somos (Resumen) -->
  <Section bg="surface-container-low">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-16 items-center">
      <div>
        <SectionHeading title="Impulsamos el desarrollo del sector">
          <Fragment slot="description">
            <p class="text-on-surface-variant font-body text-base md:text-lg leading-relaxed mb-6">
              La Cámara Boliviana de Hidrocarburos y Energía (CBHE) agrupa a las principales empresas que operan en la cadena productiva del sector hidrocarburífero y energético del país. Nuestro propósito es ser el eje articulador de la industria.
            </p>
            <p class="text-on-surface-variant font-body text-base md:text-lg leading-relaxed mb-8">
              Nuestra labor está enfocada en la coordinación técnica, el análisis normativo, la promoción de mejores prácticas y el fomento de la capacitación de excelencia, garantizando el desarrollo responsable de los recursos energéticos.
            </p>
          </Fragment>
        </SectionHeading>
        <a href="quienes-somos" class="inline-flex items-center text-primary font-semibold hover:underline hover:underline-offset-4 transition-colors">
          Conozca nuestra misión
          <Icon name="material-symbols:arrow-forward" class="size-4 ml-2" />
        </a>
      </div>

      <div class="relative h-[400px] rounded-xl overflow-hidden bg-surface-container-low shadow-sm">
        <img
          alt="Instalaciones de la CBHE con torre de estructuras metálicas bajo cielo azul"
          class="w-full h-full object-cover object-bottom brightness-90 contrast-125"
          src="images/cbhe-exterior.webp"
        />
        <div class="absolute bottom-0 left-0 right-0 bg-surface/90 backdrop-blur-sm p-6 border-t border-outline-variant/30">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-primary font-bold text-2xl">40</p>
              <p class="text-on-surface-variant text-sm font-medium">Años de trayectoria</p>
            </div>
            <div class="w-px h-12 bg-surface-container-highest"></div>
            <div>
              <p class="text-primary font-bold text-2xl">{empresas.length}</p>
              <p class="text-on-surface-variant text-sm font-medium">Empresas afiliadas</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- Grupos de Miembros -->
  <Section bg="surface">
    <SectionHeading title="Nuestras afiliadas" description="Representamos a las empresas que integran la cadena de valor de la industria energética, organizadas en cinco grupos especializados con el objetivo de lograr una coordinación eficiente." />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
      {gruposHome.map((group) => (
        <a href={`afiliadas#grupo-${groupSlugs[group.title]}`} class="block group">
          <article class="bg-surface-bright rounded-lg border border-outline-variant/30 hover:border-primary/30 hover:shadow-md hover:scale-[1.01] transition-all duration-300 h-full">
            <div class="p-6 md:p-8">
              <p class="font-headline font-extrabold text-4xl md:text-5xl text-primary mb-2 tracking-tight">{group.count}</p>
              <p class="text-xs font-semibold text-on-surface-variant uppercase tracking-wider mb-3">empresas</p>
              <h3 class="font-headline font-bold text-on-surface text-lg mb-3 group-hover:text-primary transition-colors">{group.title}</h3>
              <p class="text-on-surface-variant text-sm leading-relaxed">{group.desc}</p>
            </div>
          </article>
        </a>
      ))}
    </div>
  </Section>

  <!-- Testimonios -->
  <Section bg="surface-container-low">
    <SectionHeading
      title="Lo que dicen nuestros miembros"
      description="Empresas y profesionales del sector energético comparten su experiencia trabajando con la CBHE."
    />
    <TestimonialCarousel testimonials={testimonios} />
  </Section>

  <!-- Formulario de Afiliación -->
  <Section id="afiliacion" bg="inverse-surface" scrollMargin>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-16 items-start">
      <div>
        <h2 class="font-headline text-2xl md:text-3xl font-bold text-inverse-on-surface mb-4">Afilie a su empresa</h2>
        <p class="font-body text-base md:text-lg leading-relaxed text-inverse-on-surface/80 mb-8">
          Únase a la red más importante de empresas del sector energético en Bolivia. Complete el formulario y nuestro equipo de afiliaciones se pondrá en contacto con su empresa a la brevedad.
        </p>

        <div class="space-y-4 mb-8">
          <div class="flex items-start gap-4">
            <Icon name="material-symbols:check-circle" class="text-primary-fixed size-6 mt-0.5 shrink-0" />
            <div>
              <h4 class="font-bold text-inverse-on-surface">Representación sectorial</h4>
              <p class="text-sm text-inverse-on-surface/70">Voz activa en la defensa y promoción del sector ante instancias gubernamentales.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <Icon name="material-symbols:check-circle" class="text-primary-fixed size-6 mt-0.5 shrink-0" />
            <div>
              <h4 class="font-bold text-inverse-on-surface">Actualización técnica</h4>
              <p class="text-sm text-inverse-on-surface/70">Acceso exclusivo a estadísticas, normativas y capacitaciones de alto nivel.</p>
            </div>
          </div>
        </div>

        <a
          href="afiliacion"
          class="inline-flex items-center gap-2 text-primary-fixed font-semibold hover:underline hover:underline-offset-4 decoration-primary-fixed transition-colors"
        >
          <Icon name="material-symbols:fact-check" class="size-5" />
          Ver requisitos de afiliación
          <Icon name="material-symbols:arrow-forward" class="size-4" />
        </a>
      </div>

      <div class="bg-surface-bright p-8 rounded-lg shadow-md border border-outline-variant/30">
        <!-- Using separate icon import — the form lives inside the slot -->
        <Web3Form subject="Nueva solicitud de afiliación — CBHE" fromName="Formulario de Afiliación CBHE">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <FormInput id="company" label="Nombre de la Empresa" required autocomplete="organization" placeholder="Ej. Energía S.A.…" />
            <FormInput id="sector" label="Sector de la Industria" type="select" required options={[
              { value: "", label: "Seleccione un sector" },
              { value: "exploracion", label: "Exploración y Producción" },
              { value: "servicios-pozo", label: "Servicios en Pozo" },
              { value: "servicios-superficie", label: "Servicios en Superficie" },
              { value: "transporte", label: "Industria y Transporte" },
              { value: "auxiliares", label: "Servicios Auxiliares" },
            ]} />
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <FormInput id="contact" label="Persona de Contacto" required autocomplete="name" placeholder="Nombre completo…" />
            <FormInput id="email" label="Correo Electrónico" type="email" required autocomplete="email" placeholder="email@empresa.com…" />
          </div>
          <FormInput id="message" label="Mensaje / Comentarios" type="textarea" rows={4} placeholder="Indíquenos el motivo de su interés…" />
          <button class="w-full bg-primary text-on-primary rounded-md py-4 font-bold hover:bg-primary/90 hover:shadow-md transition-all min-h-[44px] disabled:opacity-50 flex items-center justify-center gap-2 spring-press" type="submit">
            Enviar solicitud
            <Icon name="material-symbols:send" class="size-5" />
          </button>
        </Web3Form>
      </div>
    </div>
  </Section>

  <!-- Últimas Novedades -->
  <Section bg="surface">
    <SectionHeading title="Novedades" description="Manténgase al día con las últimas noticias, eventos y análisis del sector energético boliviano." />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {ultimosArticulos.map((articulo) => (
        <article class="bg-surface-bright rounded-lg overflow-hidden border border-outline-variant/30 hover:shadow-md hover:border-primary/30 transition-all duration-300 group">
          {articulo.data.image && (
            <div class="h-48 overflow-hidden">
              <img
                alt={articulo.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
                src={resolveImageUrl(articulo.data.image)}
              />
            </div>
          )}
          <div class="p-6 flex flex-col items-start">
            <span class="text-xs font-semibold text-primary mb-2 tracking-wide uppercase">{articulo.data.category}</span>
            <h3 class="font-headline font-bold text-xl text-on-surface mb-3 line-clamp-2">{articulo.data.title}</h3>
            <p class="text-sm text-on-surface-variant mb-4 line-clamp-3">{articulo.data.excerpt}</p>
            <div class="mt-auto flex items-center justify-between w-full">
              <span class="text-xs text-on-surface-variant">{articulo.data.date}</span>
              <a href={`novedades/${articulo.id}`} class="text-sm font-semibold text-primary hover:text-on-primary-container transition-colors">Leer más</a>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="mt-8 text-center">
      <a href="novedades" class="inline-flex items-center text-primary font-semibold hover:underline hover:underline-offset-4 transition-colors">
        Ver todas las novedades
        <Icon name="material-symbols:arrow-forward" class="size-4 ml-2" />
      </a>
    </div>
  </Section>

  <!-- Alianzas Estratégicas — Infinite Marquee Ribbon -->
  <section class="bg-surface-variant py-12 sm:py-16 md:py-24 reveal">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8">
      <style>
      /*
       * ============================================================
       * RIBBON MARQUEE — CSS-only infinite scrolling logo banner.
       * Zero JS. GPU-composited (transform + opacity only).
       * Wave illusion: staggered translateY per card → flowing ribbon feel.
       * Gradient fade edges → ribbon tails.
       * ============================================================
       */

      /* 1. Marquee viewport — hides overflow, applies gradient fade mask */
      .alianzas-marquee {
        position: relative;
        overflow: hidden;
        /* Ribbon tails: fade edges to transparent */
        -webkit-mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
        mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
      }

      /* 2. Scrolling track — doubles the content for seamless infinite loop */
      .alianzas-track {
        display: flex;
        gap: 1.25rem;
        width: max-content;
        animation: marquee-scroll 28s linear infinite;
        will-change: transform;
      }
      @media (min-width: 640px) {
        .alianzas-track { gap: 1.75rem; animation-duration: 34s; }
      }
      @media (min-width: 1024px) {
        .alianzas-track { gap: 2.25rem; animation-duration: 40s; }
      }

      /* Pause on hover — user can inspect logos */
      .alianzas-marquee:hover .alianzas-track {
        animation-play-state: paused;
      }

      /* 3. Logo cards — glassmorphism + individual wave float */
      .alianzas-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        padding: 0.625rem 1rem;
        border-radius: 0.75rem;
        background: color-mix(in srgb, var(--color-surface-bright) 65%, transparent);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        transition: filter 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
        /* Ribbon wave: staggered vertical oscillation */
        animation: ribbon-wave 3.2s ease-in-out infinite;
      }
      /* Stagger delays — creates flowing ribbon illusion */
      .alianzas-logo:nth-child(1)  { animation-delay: 0.00s; }
      .alianzas-logo:nth-child(2)  { animation-delay: 0.20s; }
      .alianzas-logo:nth-child(3)  { animation-delay: 0.40s; }
      .alianzas-logo:nth-child(4)  { animation-delay: 0.60s; }
      .alianzas-logo:nth-child(5)  { animation-delay: 0.80s; }
      .alianzas-logo:nth-child(6)  { animation-delay: 1.00s; }
      .alianzas-logo:nth-child(7)  { animation-delay: 1.20s; }
      .alianzas-logo:nth-child(8)  { animation-delay: 1.40s; }
      .alianzas-logo:nth-child(9)  { animation-delay: 1.60s; }
      .alianzas-logo:nth-child(10) { animation-delay: 1.80s; }
      .alianzas-logo:nth-child(11) { animation-delay: 2.00s; }
      .alianzas-logo:nth-child(12) { animation-delay: 2.20s; }
      .alianzas-logo:nth-child(13) { animation-delay: 2.40s; }
      .alianzas-logo:nth-child(14) { animation-delay: 2.60s; }
      .alianzas-logo:nth-child(15) { animation-delay: 2.80s; }
      .alianzas-logo:nth-child(16) { animation-delay: 3.00s; }

      .alianzas-logo:hover {
        background: var(--color-surface-bright);
        box-shadow: 0 4px 20px rgba(1, 64, 108, 0.12);
      }
      .alianzas-logo img {
        height: 2rem;
        width: auto;
        max-width: 140px;
        object-fit: contain;
        filter: grayscale(1);
        transition: filter 0.3s ease;
      }
      .alianzas-logo:hover img {
        filter: grayscale(0);
      }
      @media (min-width: 768px) {
        .alianzas-logo { padding: 0.75rem 1.25rem; }
        .alianzas-logo img { height: 2.5rem; max-width: 170px; }
      }

      /* 4. Keyframes */
      @keyframes marquee-scroll {
        0%   { transform: translateX(0); }
        100% { transform: translateX(-50%); }
      }

      @keyframes ribbon-wave {
        0%, 100% { transform: translateY(0); }
        50%       { transform: translateY(-5px); }
      }

      /* 5. Accessibility: kill all motion for users who prefer it */
      @media (prefers-reduced-motion: reduce) {
        .alianzas-track,
        .alianzas-logo {
          animation: none !important;
        }
      }
