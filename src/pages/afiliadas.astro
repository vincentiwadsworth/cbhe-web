---
import { getCollection } from "astro:content";
import Icon from "../components/Icon.astro";
import AfiliadasSearch from "../components/AfiliadasSearch.astro";
import Section from "../components/Section.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SubpageHero from "../components/SubpageHero.astro";
import PageLayout from "../layouts/PageLayout.astro";

const empresas = await getCollection("empresas", ({ data }) => !data.draft);

function formatName(name: string): string {
  return name
    .toLowerCase()
    .replace(/(?:^|\s|-|\()\S/g, (c) => c.toUpperCase())
    .replace(/\bS\.\s*A\.\s*S?\.?(\s*Sucursal)?/gi, (m) => m.toUpperCase().replace(/\bS\b/g, 'S').replace(/\bA\b/g, 'A'))
    .replace(/\bS\.\s*A\./gi, 'S.A.')
    .replace(/\bS\.\s*R\.\s*L\./gi, 'S.R.L.')
    .replace(/\bLtda\.?/gi, 'Ltda.')
    .replace(/\bE\s*&\s*P\b/gi, 'E&P')
    .replace(/\bYpf\b/gi, 'YPF')
    .replace(/\bPae\b/gi, 'PAE')
    .replace(/\bGp\b/gi, 'GP')
    .replace(/\bBpe\b/gi, 'BPE')
    .replace(/\bPpo\b/gi, 'PPO')
    .replace(/\bItc\b/gi, 'ITC')
    .replace(/\bC\.?\s*R\.?\s*F\.?\b/gi, 'C.R.F.')
    .replace(/\bIa\s+Asociados\b/gi, 'IA Asociados')
    .replace(/\( /g, '(')
    .replace(/ \)/g, ')')
    .replace(/\s+/g, ' ')
    .trim();
}

const GROUPS = [
  { id: "upstream", label: "Exploración y explotación de hidrocarburos" },
  { id: "pozo", label: "Servicios y suministros especializados en pozo" },
  { id: "superficie", label: "Servicios y suministros especializados en superficie" },
  { id: "downstream", label: "Industria, transporte y distribución de hidrocarburos y energía" },
  { id: "auxiliares", label: "Servicios auxiliares" },
  { id: "adherentes", label: "Adherentes" },
];

const grouped = GROUPS
  .map((group) => ({
    ...group,
    items: empresas
      .filter((e) => e.data.grupo === group.id)
      .sort((a, b) => {
        if (a.data.orden !== b.data.orden) return a.data.orden - b.data.orden;
        return a.data.nombre.localeCompare(b.data.nombre);
      }),
  }))
  .filter((group) => group.items.length > 0);

const totalEmpresas = empresas.length;
const subtitleText = `${totalEmpresas} empresas que integran la cadena de valor del sector energético boliviano`;

// Pre-compute which A-Z letters have zero matching companies
const ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
const disabledLetters = new Set(
  [...ALPHABET].filter(
    (l) => !empresas.some((e) => e.data.nombre.toUpperCase().startsWith(l))
  )
);
---

<PageLayout
  title="Afiliadas"
  description="Directorio de empresas afiliadas a la CBHE — Más de 50 empresas que integran la cadena de valor del sector hidrocarburífero y energético en Bolivia."
  active="afiliadas"
>
  <SubpageHero
    label="Directorio"
    title="Nuestras afiliadas"
    subtitle={subtitleText}
    titleMaxW="max-w-3xl"
    subtitleSize="large"
  />

  <Section bg="surface">
    <AfiliadasSearch
      totalEmpresas={totalEmpresas}
      disabledLetters={disabledLetters}
    />

    {grouped.map((group) => (
      <details
        id={`grupo-${group.id}`}
        open
        class="accordion-group scroll-mt-24 mb-4 group/detail border border-outline-variant/30 rounded-lg"
      >
        <summary class="list-none cursor-pointer flex items-center justify-between bg-surface-container-low px-6 py-4 min-h-[44px] hover:bg-surface-container transition-colors">
          <div class="flex items-center gap-3">
            <span class="font-headline font-bold text-on-surface text-base sm:text-lg">{group.label}</span>
            <span class="inline-flex items-center text-xs font-semibold text-on-primary-container bg-primary-container rounded-md px-2.5 py-1">{group.items.length} empresas</span>
          </div>
          <Icon name="material-symbols:expand-more" class="size-6 text-on-surface-variant transition-transform duration-200 group-open/detail:rotate-180" />
        </summary>
        <div class="p-4 sm:p-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
            {group.items.map((empresa, index) => (
              <article
                data-name={empresa.data.nombre.toLowerCase()}
                data-letter={empresa.data.nombre.charAt(0).toUpperCase()}
                style={`--card-index: ${index}`}
                class:list={[
                  "reveal-card bg-surface rounded-lg p-4 sm:p-6 border border-outline-variant/30 hover:shadow-md hover:border-primary/30 transition-all duration-300",
                  empresa.data.destacada ? "card-destacada" : "",
                ]}
              >
                {empresa.data.destacada && (
                  <span class="inline-block bg-primary-container text-on-primary-container px-2 py-0.5 rounded text-xs font-semibold mb-2">
                    Destacada
                  </span>
                )}
                <h3 class="font-headline font-bold text-on-surface text-base sm:text-lg">
                  {formatName(empresa.data.nombre)}
                </h3>
                <div class="flex flex-wrap gap-3 mt-2">
                  {empresa.data.website && (
                    <a
                      href={empresa.data.website}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 text-sm text-primary hover:text-on-primary-container transition-colors"
                    >
                      <Icon name="material-symbols:open-in-new" class="size-4" />
                      Web
                    </a>
                  )}
                  {empresa.data.email && (
                    <a
                      href={`mailto:${empresa.data.email}`}
                      class="inline-flex items-center gap-1 text-sm text-primary hover:text-on-primary-container transition-colors"
                    >
                      <Icon name="material-symbols:mail" class="size-4" />
                      Contacto
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      </details>
    ))}
  </Section>

  <script is:inline>
    (function () {
      const cards = document.querySelectorAll("[data-name]");
      const groups = document.querySelectorAll(".accordion-group");
      const searchInput = document.getElementById("empresa-search");
      const counterEl = document.getElementById("result-counter");
      const emptyStateEl = document.getElementById("empty-state");
      const letterButtons = document.querySelectorAll("#az-bar .az-letter");
      const clearBtn = document.getElementById("clear-filters");
      const total = cards.length;

      let activeLetter = null;

      searchInput.addEventListener("keyup", () => {
        const q = searchInput.value.toLowerCase();
        cards.forEach((c) =>
          c.classList.toggle("hidden-by-search", !c.dataset.name.includes(q))
        );
        updateUI();
      });

      letterButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          if (btn.disabled) return;
          activeLetter =
            activeLetter === btn.dataset.letter ? null : btn.dataset.letter;
          cards.forEach((c) =>
            c.classList.toggle(
              "hidden-by-letter",
              activeLetter !== null && c.dataset.letter !== activeLetter
            )
          );
          updateLetterStyles();
          updateUI();
        });
      });

      clearBtn.addEventListener("click", () => {
        searchInput.value = "";
        activeLetter = null;
        cards.forEach((c) => {
          c.classList.remove("hidden-by-search", "hidden-by-letter");
        });
        updateLetterStyles();
        updateUI();
      });

      function updateLetterStyles() {
        letterButtons.forEach((btn) => {
          if (btn.disabled) {
            btn.classList.add("opacity-30", "cursor-default", "pointer-events-none");
            btn.classList.remove("active");
          } else if (btn.dataset.letter === activeLetter) {
            btn.classList.add("active");
            btn.classList.remove("opacity-30", "cursor-default", "pointer-events-none");
          } else {
            btn.classList.remove("active", "opacity-30", "cursor-default", "pointer-events-none");
          }
        });
      }

      function updateUI() {
        const visible = [...cards].filter(
          (c) =>
            !c.classList.contains("hidden-by-search") &&
            !c.classList.contains("hidden-by-letter")
        );
        counterEl.textContent =
          "Mostrando " + visible.length + " de " + total + " empresas";
        emptyStateEl.classList.toggle("hidden", visible.length > 0);

        groups.forEach((g) => {
          const hasVisible = g.querySelector(
            '[data-name]:not(.hidden-by-search):not(.hidden-by-letter)'
          );
          g.open = hasVisible !== null;
        });
      }
    })();
  </script>
</PageLayout>
