# Web3Forms (contact form)
WEB3FORMS_KEY=your-web3forms-key

# Groq (AI chatbot)
GROQ_KEY=your-groq-key

# Supabase — Certificate Verification System
# VITE_ prefix required: Vite exposes these to client-side code
# Uses new API key format (sb_publishable_*, sb_secret_*), NOT legacy anon/service_role
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx_xxxxxxxxxxxx

# Server-side secret key — for issuance script and GitHub Actions only (NEVER expose to client)
SUPABASE_SECRET_KEY=sb_secret_xxx_xxxxxxxxxxxx

# Public verification URL — used by QR codes on certificates
PUBLIC_VERIFICATION_URL=https://cbhe.org.bo
